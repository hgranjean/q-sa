@model Rules.WebEditor.Models.BladeEditorViewModel

@{
    Layout = null;
}

<link rel="stylesheet" href="@Url.Content("~/codemirror/addon/show-hint.css")">
<link rel="stylesheet" href="@Url.Content("~/codemirror/codemirror.css")">

<script src="@Url.Content("~/codemirror/codemirror.js")"></script>
<script src="@Url.Content("~/codemirror/javascript.js")"></script>
<!--<script src="@Url.Content("~/codemirror/clike.js")"></script>-->
<script src="@Url.Content("~/codemirror/addon/show-hint.js")"></script>
<script src="@Url.Content("~/codemirror/addon/javascript-hint.js")"></script>

<div>
    @Html.TextAreaFor(m => m.Body)

    <script>
        var editor = CodeMirror.fromTextArea(document.getElementById("Body"), {
            lineNumbers: true,
            matchBrackets: true,
            extraKeys: { "Ctrl-Space": "autocomplete" },
            mode: {name: "javascript", globalVars: true}
        });
    </script>
</div>
