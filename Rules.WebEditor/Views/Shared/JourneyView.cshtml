@using Rules.Domain
@model Rules.WebEditor.Models.JourneyViewModel

<div class="webeditor_journey" style="display: table; width: 100%">
    <div style="display: table-row">Journeys</div>
    
    @for (int i = 0; i < Model.Blades.Count; i++)
    {
        <div style="display: table-cell; width: 150px">@Html.Partial("BladeView", Model.Blades[i])</div>
    }
</div>

@if (Model.BladeEditor != null)
{
    <div style="display: table; width: 100%">
        <div style="display: table-cell; width: 100%">@Html.Partial("BladeEditorView", Model.BladeEditor)</div>
    </div>
}