@using Rules.Domain
@model Rules.WebEditor.Models.JourneyViewModel

<div class="webeditor_journey" style="display: table; width: 100%">
    <div style="display: table-row">Journey</div>
    
    <div style="display: table-row; margin: 2px;">
        @for (int i = 0; i < Model.Blades.Count; i++)
        {   
            <div class="webeditor_blade" style="display: table-cell; padding: 2px; width: 20%;">
                @Html.Partial("BladeView", Model.Blades[i])
            </div>
        }
        <div style="display: table-cell; width: 80%"></div>
    </div>
</div>

@if (Model.BladeEditor != null)
{
    using (Html.BeginForm("BladeEdit", "RuleApplication", FormMethod.Post))
    {
        <div>&nbsp;</div>
        <div style="display: table; width: 100%">
            <div style="display: table-row">Editor</div>

            <div style="display: table-cell; width: 100%">@Html.Partial("BladeEditorView", Model.BladeEditor)</div>
        </div>

        <div>&nbsp;</div>
        <input type="submit" value="Save"/>
        @Html.ActionLink("Cancel", "Index")
    }
}





