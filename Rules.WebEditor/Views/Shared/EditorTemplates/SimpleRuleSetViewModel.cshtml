@model Rules.WebEditor.Models.SimpleRuleSetViewModel

@Html.Hidden("ModelType", Model.GetType())
@Html.Hidden("Name", Model.Name)

<fieldset>
    <h3>If</h3>
    <div class="editor-indent">@Html.EditorFor(m => m.Condition)</div>
    
    <h3>Then</h3>
    <div class="editor-indent">@Html.EditorFor(m => m.Rules)</div>
    <div class="editor-indent">@Html.ActionLink("[add action]", "AddSetValueAction", "Home")</div>
    <div class="editor-indent">@Html.ActionLink("[add sendmailaction]", "AddSendMailAction", "Home")</div>
</fieldset>
   