@model Rules.WebEditor.Models.Actions.SendMailActionViewModel

@Html.Hidden("ModelType", Model.GetType())

<script type="text/javascript">
    $(function () {
        $('#dialog').dialog({
            autoOpen: false,
            width: 400,
            resizable: false,
            title: '@Model.Name',
            modal: true,
            open: function (event, ui) {
                //Load the CreateAlbumPartial action which will return
                // the partial view _CreateAlbumPartial
                $(this).load("@Url.Action("EditAction")");
            },
            buttons: {
                "OK": {
                    text: "OK", style: "width: 100px", click: function () {
                    $("#editForm").submit();
                    /*$(this).dialog("close");*/
                        return true;
                    }},
                "Cancel": { text:"Cancel", style: "width: 100px", click: function () {
                    $(this).dialog("close");
                }}
            }
        });

        $('#my-button').click(function () {
            $('#dialog').dialog('open');
            return false;
        });
    });
</script>

<fieldset>
    <legend>Send mail</legend>

    <div class="editor-label hasmenu" style="float: left;" id="@Model.Name">Name</div>
    <div class="editor-field" style="float: left;"><a href="#" id="my-button">@Model.Name</a>@* Html.ActionLink(Model.Name, "EditAction", "Home", new { id = Model.Name }, new { @class = "modal" })*@ </div>
</fieldset>

<div id ="update-message"></div>

@using (Ajax.BeginForm("SaveSendMailAction", "Home", null, new AjaxOptions
{
    UpdateTargetId = "update-message",
    InsertionMode = InsertionMode.Replace,
    HttpMethod = "POST",
    //OnBegin = "ajaxValidate",
    OnSuccess = "updateSuccess"

}, new {@id = "editForm"}))
{
    <div id="dialog" title="@Model.Name">
        <fieldset>
            <legend>Send mail</legend>

            <div class="editor-label hasmenu" style="float: left;">From</div>
            <div class="editor-field" style="float: left;">@Html.TextBoxFor(m => m.From.ExpressionValue)</div>
            <div class="editor-label hasmenu" style="float: left;">To</div>
            <div class="editor-field" style="float: left;">@Html.TextBoxFor(m => m.To.ExpressionValue)</div>
            <div class="editor-label hasmenu" style="float: left;">Subject</div>
            <div class="editor-field" style="float: left;">@Html.TextBoxFor(m => m.Subject.ExpressionValue)</div>
            <div class="editor-label hasmenu" style="float: left;">Body</div>
            <div class="editor-field" style="float: left;">@Html.TextAreaFor(m => m.Body.ExpressionValue, new {@style = "width: 300px;"})</div>
            <div style="clear: both"></div>
        </fieldset>
    </div>
}
