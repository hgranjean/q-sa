@model Rules.WebEditor.Models.Actions.SetValueActionViewModel

@Html.Hidden("ModelType", Model.GetType())

<fieldset>
    <legend>Target</legend>    
    
    <div class="editor-label">Target</div>
    <div class="editor-field">@Html.TextBoxFor(m => m.Target.ExpressionValue)</div>

    <div class="editor-label">Value</div>
    <div class="editor-field">@Html.TextBoxFor(m => m.Value.ExpressionValue)</div>
</fieldset>

