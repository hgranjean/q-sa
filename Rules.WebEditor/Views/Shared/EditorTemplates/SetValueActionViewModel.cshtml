@model Rules.WebEditor.Models.Actions.SetValueActionViewModel

@Html.Hidden("ModelType", Model.GetType())
@Html.Hidden("Name", Model.Name)

<fieldset>
    <legend>Target</legend>    
    
    <div class="editor-label hasmenu" style="float: left;" id="@Model.Name">Set</div>
    <div class="editor-field" style="float: left;">@Html.TextBoxFor(m => m.Target.ExpressionValue)</div>

    <div class="editor-label" style="float: left;">To</div>
    <div class="editor-field" style="float: left;">@Html.TextBoxFor(m => m.Value.ExpressionValue)</div>
</fieldset>

