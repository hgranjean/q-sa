<?xml version="1.0" encoding="utf-8"?>
<!--
This file is used by the publish/package process of your Web project. You can customize the behavior of this process
by editing this MSBuild file. In order to learn more about this please visit http://go.microsoft.com/fwlink/?LinkID=208121. 
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <LastUsedBuildConfiguration>Debug</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>http://www.aqspartners.com/survey</SiteUrlToLaunchAfterPublish>
    <ExcludeApp_Data>False</ExcludeApp_Data>
    <MSDeployServiceURL>https://web805.discountasp.net:8172/MsDeploy.axd</MSDeployServiceURL>
    <DeployIisAppPath>aqspartners.com/survey</DeployIisAppPath>
    <RemoteSitePhysicalPath />
    <SkipExtraFilesOnServer>True</SkipExtraFilesOnServer>
    <MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
    <EnableMSDeployBackup>True</EnableMSDeployBackup>
    <UserName>aqspartners</UserName>
    <_SavePWD>True</_SavePWD>
    <PublishDatabaseSettings>
      <Objects xmlns="">
        <ObjectGroup Name="SurveyWeb.Models.ApplicationDbContext" Order="5" Enabled="False">
          <Destination Path="" />
          <Object Type="DbCodeFirst">
            <Source Path="DBContext" DbContext="SurveyWeb.Models.ApplicationDbContext, SurveyWeb" />
          </Object>
        </ObjectGroup>
        <ObjectGroup Name="AtumSurveillanceContainer" Order="7" Enabled="False">
          <Destination Path="" />
          <Object Type="DbCodeFirst">
            <Source Path="DBContext" DbContext="SurveyWeb.Database.AtumSurveillanceContainer, SurveyWeb" Origin="Configuration" />
          </Object>
        </ObjectGroup>
        <ObjectGroup Name="AtumSurveillanceContext" Order="8" Enabled="False">
          <Destination Path="" />
          <Object Type="DbCodeFirst">
            <Source Path="DBMigration" DbContext="Atum.Database.Surveillance.Models.AtumSurveillanceContext, Atum.Database.Surveillance" MigrationConfiguration="Atum.Database.Surveillance.Migrations.Configuration, Atum.Database.Surveillance" Origin="Configuration" />
          </Object>
        </ObjectGroup>
      </Objects>
    </PublishDatabaseSettings>
    <LaunchSiteAfterPublish>True</LaunchSiteAfterPublish>
  </PropertyGroup>
  <ItemGroup>
    <MSDeployParameterValue Include="$(DeployParameterPrefix)AtumSurveillanceContainer-Web.config Connection String" />
    <MSDeployParameterValue Include="$(DeployParameterPrefix)AtumSurveillanceContext-Web.config Connection String" />
    <MSDeployParameterValue Include="$(DeployParameterPrefix)SurveyWeb.Models.ApplicationDbContext-Web.config Connection String" />
  </ItemGroup>
  <ItemGroup>
    <_ConnectionStringsToInsert Include="SurveyWeb.Models.ApplicationDbContext" />
  </ItemGroup>
</Project>