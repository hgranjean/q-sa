@model SurveyWeb.Models.PerformanceElementViewModel

@{
    ViewBag.Title = "Performance Element - Notes and Related Elements";
}

<h2><span>@Model.StandardId</span>: Element of Performance EP- <span>@Model.EPId</span></h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>@Model.Title</h4>
        <hr />
        @Html.ValidationSummary(true)
        <div class="form-group">
                    @Html.ValidationMessageFor(model => model.Title)
        </div>

        <div class="form-group">
            @foreach (string item in Model.Notes)
            {
                <div class="col-md-offset-0 col-md-10">
                    <span>@item</span>
                </div>
            }

            @foreach (HtmlString refLink in Model.ReferencedElementLinks)
            {
                <div>@refLink</div>
            }
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
