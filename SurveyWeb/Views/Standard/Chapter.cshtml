@model SurveyWeb.Models.StandardDocumentViewModel

@{
    ViewBag.Title = "Chapter";
}

<h2>Chapter</h2>


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    
    <div class="form-horizontal">
        <h4>StandardDocumentViewModel</h4>
        <hr />
        @Html.ValidationSummary(true)
        <div class="form-group">
            @Html.LabelFor(model => model.Title, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Title)
                @Html.ValidationMessageFor(model => model.Title)
            </div>
        </div>

        <div class="form-group">
        @foreach (var item in Model.TableOfContents)
            {
            <div class="col-md-offset-0 col-md-10">
                @Html.ActionLink(item.Title, "ElementsOfPerformance", new { contentId = item.Key }, null)

            </div>
        }
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Save" class="btn btn-default" />
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Back to List", "Index")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
