@model SurveyWeb.Models.StandardSearchViewModel

@{
    ViewBag.Title = "Documents - Standards and Guidelines";
}

<h2>Search Documents </h2>

<form action="submit" method="post">
    <div>
        <h4>Search</h4>
        <hr />
        <dl class="dl-horizontal">
            <dt>
                @Html.DisplayNameFor(model => model.StandardId)
            </dt>

            <dd>
                @Html.TextBoxFor(model => model.StandardId)
            </dd>

            <dt>
                @Html.DisplayNameFor(model => model.StandardTypes)
            </dt>

            <dd>
                @* @Html.DropDownListFor(model => model.StandardTypes)*@
                @Html.DropDownListFor(m => m.StandardTypeId, new SelectList(Model.StandardTypes, "Id", "Name"), "Please select...", new { @class = "form-control" })
            </dd>

        </dl>
    </div>
    <p>@Html.ActionLink("Search", "Documents", new { @class = "btn btn-default" })</p>
    <p>@Html.ActionLink("New", "Document", new { @class = "btn btn-default" })</p>
</form>
