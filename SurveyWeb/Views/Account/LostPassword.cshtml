@model SurveyWeb.Models.LostPasswordModel
@{
    ViewBag.Title = "Lost Password";
}

<div class="hero_bg">
    <div class="row">
        <div class="col-md-8">
            <section id="lostPasswordForm">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
       
                    <h4>Provide your account information to restore access.</h4>
                    <hr />   
                    @Html.ValidationSummary(true)

                    <div class="form-group">
                        @Html.LabelFor(m => m.Email, new { @class = "col-md-2 control-label" })
                    
                        <div class="col-md-10">
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Email)
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-md-offset-2 col-md-10">                            
                            <input type="submit" value="Recover Account" class="btn btn-default" />
                        </div>
                    </div>                    
                }
            </section>
        </div>
    </div>
</div>
