@using MvcApplication1.Controllers
@using SurveyWeb.Models
@model QuestionGroupViewModel

@{
    ViewBag.Title = "Edit Question Group";
}

<h2>Edit Element</h2>

<script src="~/Scripts/jquery-1.8.2.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

@*using (Html.BeginForm("EditQuestionGroup", "Survey", FormMethod.Post, new { enctype = "multipart/form-data" }))*@
@*{*@
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    <fieldset>
        <legend>Questions</legend>

        @Html.HiddenFor(m => m.Number)
        @Html.HiddenFor(m => m.SurveyId)
        
        <div style="display: table; width: 100%">
            <div style="display: table-row">
                <div id="groupLabel" style="display: table-cell; font-weight: bold; width: 20%">@Html.LabelFor(m => m.QuestionGroup.Title, new { style = "width: 80%", @class = "control-label" })</div>
                <div id="groupTitle" style="display: table-cell; font-weight: bold; width: 80%">@Html.TextBoxFor(m => m.QuestionGroup.Title, new { style = "width: 80%", @class="form-control"})</div>
            </div>
        </div>
       
        <div style="display: table;width:100%">
            @for (int i=0;Model.QuestionGroup.Questions!=null&&i<Model.QuestionGroup.Questions.Count;i++)
            {
                @Html.HiddenFor(m => m.QuestionGroup.Questions[i].Number)
                                
                <div id="choiceGroup" style="display: table-row"  >
                    <div class="editor-label;" style="display: table-cell;width: 3%">
                        @Html.Label(Model.QuestionGroup.Questions[i].Number.ToString(), new{@class="control-label"})
                    </div>
                    <div id="questionText" class="editor-field" style="display: table-cell;width: 70%">
                        @Html.TextBoxFor(m => m.QuestionGroup.Questions[i].Text, new { style = "width: 100%", @class="form-control"} )
                    </div>
                    <div id="questionType" class="editor-field" style="display: table-cell;width: 10%">
                        @Html.DropDownListFor(m => m.QuestionGroup.Questions[i].QuestionType,
                                              Model.QuestionGroup.Questions[i].QuestionType.ToSelectList(Model.QuestionGroup.Questions[i].QuestionType.ToString()), new { style = "width: auto", @class="form-control"}) 
                    </div>
                    <div id="questionStandard" class="editor-field" style="display: table-cell;width: 17%">
                        @Html.DropDownListFor(m => m.QuestionGroup.Questions[i].TOCReference, 
                                              new SelectList(Model.AvailableTOCs, "Value.Title", "Key", Model.QuestionGroup.Questions[i].TOCReference), new { style = "width: auto", @class="form-control"})
                    </div>
                </div>                
            }
        </div>

        <div>
            @Html.ActionLink("Add question", "AddQuestion", new {surveyId = Model.SurveyId, questionGroupId = Model.Number})
        </div>

        <div>
            <input type="submit" value="Save" />
        </div>
    </fieldset>
@*}*@

<div>
    @Html.ActionLink("Back to survey", "SurveyDesign", new{id=Model.SurveyId})
</div>
