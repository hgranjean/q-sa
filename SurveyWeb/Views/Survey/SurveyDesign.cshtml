@using Atum.Domain.SurveyManagement
@using SurveyWeb.Models
@model SurveyWeb.Models.SurveyViewModel
@{
    ViewBag.Title = "Edit Surveillance Template";
}

<hgroup class="title">
    <h1>@ViewBag.Title</h1>
</hgroup>

@*using (Html.BeginForm("Save", "Survey", FormMethod.Post, new {enctype="multipart/form-data"}))
{*@
    @Html.AntiForgeryToken()
    @Html.ValidationSummary()

    <fieldset>
        <legend>Edit Surveillance Template</legend>

        @Html.HiddenFor(m => m.Survey.ID)
        @Html.HiddenFor(m => m.Survey.Guid)

        <div style="display: table">
            
            <div style="display: table-row" class="form-group">                
                <div style="display: table-cell; width: 30%"  class="editor-label">
                    @Html.LabelFor(m => m.Survey.Title, new { @class = "control-label" })
                </div>
                <div style="display: table-cell; width: 70%" class="editor-field">
                    @Html.TextBoxFor(m => m.Survey.Title, new { @class = "form-control" })
                </div>
            </div>
            <div style="display: table-row; width: 30%" class="form-group">
                <div style="display: table-cell; margin-top: 5px;" class="editor-label">
                    @Html.LabelFor(model => model.Survey.SurveyType, new { @class = "control-label" })
                </div>
                <div style="display: table-cell; width: 70%" class="editor-field">
                    @Html.DropDownListFor(model => model.Survey.SurveyType,
                                          new SelectList(EnumUtils.GetEnumerableItems(typeof(SurveyType)),
                                                         "Value", "Text"), new { @class = "form-control" })
                </div>
            </div>
        </div>
        <div style="display: table; width: 100%">

            <script>
                $(document).ready(function () {
                    $('.questionEdit').click(function () {

                        $(this).hide();

                        var parentId = $(this).parents('li').map(function () {
                            return $(this).find('a').first().attr("data-ng-href");
                        }).get().join(", ");

                        $.ajax({
                            type: 'GET',
                            url: '@Url.Content("~/Survey/EditQuestion")',
                            data: {
                                surveyId: "@Model.Survey.ID",
                                questionId: parentId,
                            },
                            success: function (data) {
                                $('#divid' + parentId).html(data);
                                $('.questionEdit').hide();
                                $('.questionDelete').hide();
                            },
                            error: function (xhr, status, error) {
                                console.log(xhr.responseText);
                            }
                        });

                    });

                    $('.questionAdd').click(function () {

                        var parentId = $(this).parents('li').map(function () {
                            return $(this).find('a').first().attr("data-ng-href");
                        }).get().join(", ");

                        var parentGroupId = $(this).parents('li').parents('ul').map(function () {
                                return $(this).find('ul').first().attr("data-ng-href");
                        }).get().join(", ");

                        $.ajax({
                            type: 'POST',
                            url: '@Url.Content("~/Survey/AddQuestion")',
                            data: {
                                surveyId: "@Model.Survey.ID",
                                questionGroupId: parentGroupId,
                            },
                            success: function (data) {
                                $("#questionGroup0").append('<li class="questionItem"><div style="display: table-row"><div style="display: table-cell; column-span: all">' + data + '</div></div></li>');
                            },
                            error: function (xhr, status, error) {
                                console.log(xhr.responseText);
                            }
                        });
                    });

                    $('.questionDelete').click(function () {

                        var parentId = $(this).parents('li').map(function () {
                            return $(this).find('a').first().attr("data-ng-href");
                        }).get().join(", ");

                        var parentGroupId = $(this).parents('li').parents('ul').map(function () {
                            return $(this).find('ul').first().attr("data-ng-href");
                        }).get().join(", ");

                        var liToDelete = $(this).closest('li');

                        $.ajax({
                            type: 'POST',
                            url: '@Url.Content("~/Survey/DeleteQuestion")',
                            data: {
                                surveyId: "@Model.Survey.ID",
                                questionGroupId: parentGroupId,
                                questionId: parentId
                            },
                            success: function (data) {
                                liToDelete.remove();
                            },
                            error: function (xhr, status, error) {
                                console.log(xhr.responseText);
                            }
                        });
                    });
                });
            </script>

            <h3 style="column-span: all;">Elements</h3>
            <div style="display: table-row;">
                <div style="display: table-cell; width: 100%">
                    @Html.EditorFor(m => m.QuestionGroupsViewModel)
                </div>
            </div>

            <div style="display: table-row">
                <div style="display: table-cell; margin-top: 5px;" class="editor-label">
                    @Html.ActionLink("Create New Element", "CreateQuestionGroup", new { surveyId = Model.Survey.ID.ToString() })
                </div>
            </div>

        </div>
        
        @Html.ActionLink("Done", "Surveys", "Survey", null, new { @class = "btn btn-default" })
    </fieldset>
@*}*@

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
