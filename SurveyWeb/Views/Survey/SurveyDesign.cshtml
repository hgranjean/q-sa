@using Atum.Domain.SurveyManagement
@using SurveyWeb.Models
@model SurveyViewModel
@{
    ViewBag.Title = "Edit Template";
}

<hgroup class="title">
    <h1>@ViewBag.Title</h1>
</hgroup>

<script type="text/javascript">
    $.addQuestionPath = '@Url.Content("~/Survey/AddQuestion")';
    $.editQuestionPath = '@Url.Content("~/Survey/EditQuestion")';
    $.deleteQuestionPath = '@Url.Content("~/Survey/DeleteQuestion")';
    $.surveyEditHeaderPath = '@Url.Content("~/Survey/EditSurveyHeader")';
    $.surveyDesignPath = '@Url.Content("~/Survey/SurveyDesign")';
</script>
<script type="text/javascript" src="~/Scripts/AQS/surveydesign.js"></script>

@*using (Html.BeginForm("Save", "Survey", FormMethod.Post, new {enctype="multipart/form-data"}))
{*@
    @Html.AntiForgeryToken()
    @Html.ValidationSummary()

    <fieldset>
        <legend>Edit Template</legend>

        @Html.HiddenFor(m => m.Survey.Id)
        @Html.HiddenFor(m => m.Survey.Guid)

        <div style="display: table">
            
            <form id="surveyHeader">
                
                @Html.HiddenFor(m => m.Survey.Id)

                <div style="display: table-row" class="form-group">
                    <div style="display: table-cell; width: 30%" class="editor-label">
                        @Html.LabelFor(m => m.Survey.Title, new { @class = "control-label" })
                    </div>
                    <div style="display: table-cell; width: 70%" class="editor-field">
                        @Html.TextBoxFor(m => m.Survey.Title, new { @class = "form-control" })
                    </div>
                </div>
                <div style="display: table-row; width: 30%" class="form-group">
                    <div style="display: table-cell; margin-top: 5px;" class="editor-label">
                        @Html.LabelFor(model => model.SurveyType, new { @class = "control-label" })
                    </div>
                    <div style="display: table-cell; width: 70%" class="editor-field">
                        @Html.DropDownListFor(model => model.SurveyType,
                            new SelectList(EnumUtils.GetEnumerableItems(typeof(SurveyType)),
                                "Value", "Text"), new { @class = "form-control" })
                    </div>
                </div>
            </form>
            
            <a class="surveyEditHeader btn btn-default" href="#">Update Title/Type</a>
        </div>
        <div style="display: table; width: 100%">

            <h3 style="column-span: all;">Elements @Html.ActionLink("+", "CreateQuestionGroup", new { surveyId = Model.Survey.Id })</h3>
            <div style="display: table-row;">
                <div style="display: table-cell; width: 100%">
                    @Html.EditorFor(m => m.QuestionGroupsViewModel)
                </div>
            </div>

            <div style="display: table-row">
                <div style="display: table-cell; margin-top: 5px;" class="editor-label">
                    &nbsp;
                </div>
            </div>
        </div>

        @Html.ActionLink("Done", "Surveys", "Survey", null, new { @class = "btn btn-default" })
    </fieldset>
@*}*@

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
