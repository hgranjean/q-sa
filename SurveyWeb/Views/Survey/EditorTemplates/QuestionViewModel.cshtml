@model SurveyWeb.Models.QuestionViewModel

@Html.Hidden("ModelType", Model.Question.GetType())

<div id="divid@(Model.Number)" style="display: table; width: 100%; margin-top: 5px; min-height: 34px">
    <div style="display: table-row">
        <div style="display: table-cell; width: 70%;">
            <div style="display: inline">
                <span style="width: 5em;">@Html.DisplayFor(m => m.Number)</span>-<span>@Html.DisplayFor(m => m.Text)</span>
            </div>
        </div>
        <div style="display: table-cell; width: 30%; margin-top: 5px">
            <div style="display: inline"><a class="questionEdit btn btn-default" data-ng-href="@(Model.Number)" href="#">Edit</a></div>
            <div style="display: inline"><a class="questionDelete btn btn-default" data-ng-href="@(Model.Number)" href="#">Delete</a></div>
        </div>
    </div>
</divid>

