@using Atum.Database.Surveillance.Models
@model IEnumerable<SurveyWeb.Models.UserHospitalViewModel>

@{
    ViewBag.Title = "Manage Users";
}

<h2>Manager Users</h2>

<!-- Users -->

<fieldset>
    <legend>Users</legend>
    <div style="display: table">
        <div style="display: table-row">
            <div style="display: table-cell; width: 100px">Username</div>
            <div style="display: table-cell; width: 100px"></div>
        </div>

        @foreach (AspNetUser item in ViewBag.Users)
        {
            <div style="display: table-row">
                <div style="display: table-cell">@Html.Label(item.UserName)</div>
                <div style="display: table-cell">@Html.ActionLink("Edit", "EditUserHospital", new { userId=item.Id })</div>
            </div>
        }
    </div>
</fieldset>

