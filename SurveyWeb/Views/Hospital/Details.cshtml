
@model Atum.Domain.Business.Hospital

@{
    ViewBag.Title = "Details";
}

<h2>Details</h2>

<fieldset>
    <legend>Hospital Form</legend>

<div style="display:table">
            <div style="display:table-row">
                <div style="display:table-cell">
                    <div class="editor-label">
                        @Html.LabelFor(model => model.Name)
                    </div>
                </div>
                <div style="display:table-cell">
                    <div class="editor-field">
                        @Html.DisplayTextFor(model => model.Name)
                    </div>
                </div>
            </div>
            <div style="display:table-row">
                <div style="display:table-cell">
                    <div class="editor-label">
                        @Html.LabelFor(model => model.Industry)
                    </div>
                </div>
                <div style="display:table-cell">
                    <div class="editor-field">
                        @Html.DisplayTextFor(model => model.Industry)
                    </div>
                </div>
            </div>
            <div style="display:table-row">
                <div style="display:table-cell">
                    <div class="editor-label">
                        @Html.LabelFor(model => model.DomainName)
                    </div>
                </div>
                <div style="display:table-cell">
                    <div class="editor-field">
                        @Html.DisplayTextFor(model => model.DomainName)
                    </div>
                </div>
            </div>
        </div>
        
</fieldset>

@Html.ActionLink("Return to list", "Index")