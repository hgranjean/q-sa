
@model Atum.Domain.Business.Hospital

@{
    ViewBag.Title = "Edit";
}

<h2>Hospital Info</h2>

@using (Html.BeginForm("Edit", "Hospital"))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary()

    <fieldset>
        <legend>Hospital Form</legend>

        <div style="display:table">
            <div style="display:table-row">
                <div style="display:table-cell">
                    <div class="editor-label">
                        @Html.LabelFor(model => model.Name)
                    </div>
                </div>
                <div style="display:table-cell">
                    <div class="editor-field">
                        @Html.EditorFor(model => model.Name)
                    </div>
                </div>
            </div>
            <div style="display:table-row">
                <div style="display:table-cell">
                    <div class="editor-label">
                        @Html.LabelFor(model => model.Industry)
                    </div>
                </div>
                <div style="display:table-cell">
                    <div class="editor-field">
                        @Html.EditorFor(model => model.Industry)
                    </div>
                </div>
            </div>
            <div style="display:table-row">
                <div style="display:table-cell">
                    <div class="editor-label">
                        @Html.LabelFor(model => model.DomainName)
                    </div>
                </div>
                <div style="display:table-cell">
                    <div class="editor-field">
                        @Html.EditorFor(model => model.DomainName)
                    </div>
                </div>
            </div>
        </div>
        
    </fieldset>
    
    <br/>
    <input type="submit" value="Save" class="btn btn-default"/>
    @Html.ActionLink("Return to list", "Index", null, new { @class="btn"})
}