@model Atum.Domain.Business.Hospital

@{
    ViewBag.Title = "Delete";
}

<h2>Delete</h2>



@using (Html.BeginForm("Delete", "Hospital"))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary()

    <fieldset>
        <legend>Hospital</legend>

        <div class="editor-label">
            Do you want to delete "@Html.DisplayTextFor(m => m.Name)" ?
        </div>
    </fieldset>
    
    <br/>
    
    <input type="submit" value="Delete" />
    
    @Html.ActionLink("Cancel", "Index", "Hospital")
}