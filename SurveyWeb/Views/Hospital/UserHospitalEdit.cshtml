@using SurveyWeb.Models
@model SurveyWeb.Models.UserHospitalViewModel

@{
    ViewBag.Title = "User Edit";
}

<h2>User Edit - @ViewBag.UserName</h2>

@using (Html.BeginForm("EditUserHospital", "Hospital", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary()

    <fieldset>
        <legend>User Roles</legend>

        <div class="editor-label">
            @Html.LabelFor(model => model.Roles)
        </div>
        <div class="editor-field">
            @Html.ListBoxFor(model => model.Roles, new MultiSelectList(Model.Roles, "Id", "Name"))
        </div>
        
        <br/>
        
        <caption>To change selected items, choose necessary from the list below and click Save</caption>
        
        <div class="editor-label">
            @Html.LabelFor(model => model.AvailableRoles)
        </div>
        <div class="editor-field">
            @Html.ListBoxFor(model => model.SelectedRoles, new MultiSelectList(Model.AvailableRoles, "Id", "Name"))
        </div>
    </fieldset>


    <fieldset>
        <legend>User Hospitals</legend>

        <div class="editor-label">
            @Html.LabelFor(model => model.Hospitals)
        </div>
        <div class="editor-field">
            @Html.ListBoxFor(model => model.Hospitals, new MultiSelectList(Model.Hospitals, "Id", "Name"))
        </div>
        
        <br/>
        
        <caption>To change selected items, choose necessary from the list below and click Save</caption>
        
        <div class="editor-label">
            @Html.LabelFor(model => model.AvailableHospitals)
        </div>
        <div class="editor-field">
            @Html.ListBoxFor(model => model.SelectedHospitals, new MultiSelectList(Model.AvailableHospitals, "Id", "Name"))
        </div>
        
        <div class="editor-label">
            @Html.LabelFor(model => model.LockoutEnabled)
        </div>
        <div class="editor-field">
            @Html.CheckBoxFor(model => model.LockoutEnabled)
        </div>
        
        @Html.HiddenFor(model => model.UserId)
        
    </fieldset>
    
    <br/>
    <input type="submit" value="Save" class="btn btn-default" />
    @Html.ActionLink("Return to list", "UserHospitalIndex");
}