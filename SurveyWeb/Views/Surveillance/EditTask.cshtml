@using System.Web.Mvc;
@model SurveyWeb.Models.TaskViewModel
@{
    ViewBag.Title = "Edit Task";
}

<h2>Edit Task</h2>

<link rel="stylesheet" href="//code.jquery.com/ui/1.10.4/themes/smoothness/jquery-ui.css">
@Scripts.Render("~/Scripts/jquery-ui-timepicker.js")

<script>
  $(function() {
      $("#startdatepicker").datetimepicker({
          timeFormat: 'HH:mm z',
          timezoneList: [
			{ value: -300, label: 'Eastern' },
			{ value: -360, label: 'Central' },
			{ value: -420, label: 'Mountain'},
			{ value: -480, label: 'Pacific' }
          ]
      });
      $("#enddatepicker").datetimepicker({
          timeFormat: 'HH:mm z',
          timezoneList: [
			{ value: -300, label: 'Eastern' },
			{ value: -360, label: 'Central' },
			{ value: -420, label: 'Mountain'},
			{ value: -480, label: 'Pacific' }
          ]
      });
  });
</script>

@using (Html.BeginForm("EditTask", "Surveillance", FormMethod.Post, new {enctype="multipart/form-data"}))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary()

    <fieldset>
        <legend>Task Info</legend>

        @Html.HiddenFor(m => m.Id)

        <div style="display: table">
            
            <div style="display: table-row">
                <div class="editor-label" class="table-cell">
                    @Html.LabelFor(m => m.Title)
                </div>
                <div class="editor-field" class="table-cell">
                    @Html.TextBoxFor(m => m.Title, new { @class = "form-control" })
                </div>
            </div>
            <div style="display: table-row">
                <div class="editor-label" class="table-cell">
                    @Html.LabelFor(model => model.Start)
                </div>
                <div class="editor-field" class="table-cell">
                    @Html.TextBoxFor(m => m.Start, new { @id = "startdatepicker", @class = "form-control" })
                </div>
            </div>
            <div style="display: table-row">
                <div class="editor-label" class="table-cell">
                    @Html.LabelFor(model => model.End)
                </div>
                <div class="editor-field" class="table-cell">
                    @Html.TextBoxFor(m => m.End, new { @id = "enddatepicker", @class = "form-control" })
                </div>
            </div>

            <div style="display: table-row">
                <div class="editor-label" class="table-cell">
                    @Html.LabelFor(model => model.Survey)
                </div>
                <div class="editor-field" class="table-cell">
                    @Html.DropDownListFor(m => m.SurveyId, new SelectList(Model.AvailableSurveys, "Id", "Title"), "Please select...", new { @class = "form-control" })
                </div>
            </div>
        </div>
    </fieldset>

    <fieldset>
        <legend>Assigned Users</legend>

        <div class="editor-label">
            @Html.LabelFor(model => model.SelectedUsers)
        </div>
        <div class="editor-field">
            @Html.ListBoxFor(model => model.SelectedUsers, new MultiSelectList(Model.Users, "Id", "Person.FullName"), new { @class = "form-control" })
        </div>
        
        <br/>
        
        <caption>To change selected items, choose necessary from the list below and click Save</caption>
        
        <div class="editor-label">
            @Html.LabelFor(model => model.AvailableUsers)
        </div>
        <div class="editor-field">
            @Html.ListBoxFor(model => model.SelectedUsers, new MultiSelectList(Model.AvailableUsers, "Id", "Person.FullName"), new { @class = "form-control" })
        </div>
    </fieldset>

    <div>
        <input type="submit" value="Save" />
        @Html.ActionLink("Cancel", "Calendar", "Surveillance")
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}





