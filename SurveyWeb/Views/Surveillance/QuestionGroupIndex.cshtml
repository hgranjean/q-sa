@model SurveyWeb.Models.SurveyViewModel

<div>
    @Html.ActionLink("Create New Group", "CreateQuestionGroup", new {surveyId = Model.Survey.ID})
</div>
 
<div>
<table>
    <tr>
        <th>
            @Html.DisplayNameFor(model => model)
        </th>
        <th></th>
    </tr>

    @foreach (var key in Model.Survey.QuestionGroups.Keys) {
    <tr>
        <td>
            <div><span>Group-</span>@Html.DisplayFor(modelItem => Model.Survey.QuestionGroups[key].Number)</div>
            @foreach (var question in Model.Survey.QuestionGroups[key].Questions)
            {
                <div><span>@question.Number</span>-<span>@question.Text</span></div>
            }
        </td>
        <td>
            @Html.ActionLink("Edit", "EditQuestionGroup", new { surveyId = Model.Survey.ID, groupId=key }) |
            <!-- @Html.ActionLink("Details", "Details", new { surveyId = Model.Survey.ID, groupId=key }) | -->
            @Html.ActionLink("Delete", "DeleteQuestionGroup", new { surveyId = Model.Survey.ID, groupId=key })
        </td>
    </tr>
}

</table>
</div>