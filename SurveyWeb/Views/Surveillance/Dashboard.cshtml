@using Microsoft.AspNet.Identity
@using Microsoft.AspNet.Identity.Owin
@using SurveyWeb
@using SurveyWeb.App_Start
@using SurveyWeb.Models
@{

    ViewBag.Title = "Dashboard";
}


<h2>Dashboard</h2>
 
@if (ViewBag.ShowAdminContent)
{
    <div>
        <div><h3>Assessment Administrator Dashboard</h3></div>
        <div>@Html.ActionLink("Templates", "Surveys")</div>
        <div>@Html.ActionLink("Schedules", "SurveySchedules")</div>
        <div>@Html.ActionLink("Completed Assessments", "CompletedSurveys")</div>
        <div>@Html.ActionLink("Pass Due Assessments", "Surveys")</div>
        <div>@Html.ActionLink("Follow-ups", "Surveys")</div>
        <div>@Html.ActionLink("Reports", "Surveys")</div>
        <div>@Html.ActionLink("Invite  People", "InvitePeople", "Account")</div>
    </div>
}
else if (ViewBag.ShowSurveyorContent)
{
    <div>
        <div><h3>Surveyor Dashboard</h3></div>
        <div>@Html.ActionLink("Calendar", "Calendar")</div>
        <div>@Html.ActionLink("Scheduled", "SurveySchedules")</div>
        <div>@Html.ActionLink("Completed Assessments", "Surveys")</div>
        <div>@Html.ActionLink("Pass Due Assessments", "Surveys")</div>
        <div>@Html.ActionLink("Follow-ups", "Surveys")</div>
    </div>
}
else
{
    <div>
        <div><h3>User Dashboard</h3></div>
        <div>@Html.ActionLink("Contact your Administrator to get access to the system", "About", "Home")</div>
    </div>
}