@using Microsoft.AspNet.Identity
@using Microsoft.AspNet.Identity.Owin
@using SurveyWeb
@using SurveyWeb.App_Start
@using SurveyWeb.Models
@{

    ViewBag.Title = "Dashboard";
}


<h2>Dashboard</h2>
 
@if (ViewBag.ShowAdminContent || ViewBag.ShowManagerContent)
{
    <div>
        <div><h3>Manager Dashboard</h3></div>
        <div>@Html.ActionLink("Calendar", "Calendar")</div>
        <div>@Html.ActionLink("Templates", "Surveys")</div>
        <div>@Html.ActionLink("Scheduled Audits", "SurveySchedules")</div>
        <div>@Html.ActionLink("Completed Audits", "CompletedSurveys")</div>
        <div>@Html.ActionLink("Annual Schedule", "Surveys")</div>
        <div>@Html.ActionLink("Pass Due Audits", "PastDueSurveys")</div>
        <div>@Html.ActionLink("Follow-ups", "Surveys")</div>
        <div>@Html.ActionLink("Manage Standard", "Document", "Standard", new { id = 1 }, null)</div>
        <div>@Html.ActionLink("Completion Grid", "CompletedSurveys")</div>
        <div>@Html.ActionLink("Reports", "Index", "Report")</div>
        <div>@Html.ActionLink("Invite  People", "InvitePeople", "Account")</div>
        <div>@Html.ActionLink("Observation Classification", "ObservationClassifier","Learning")</div>

    </div>
}
else if (ViewBag.ShowTeamMemberContent)
{
    <div>
        <div><h3>Team Dashboard</h3></div>
        <div>@Html.ActionLink("Calendar", "Calendar")</div>
        <div>@Html.ActionLink("Scheduled", "SurveySchedules")</div>
        <div>@Html.ActionLink("Completed Assessments", "Surveys")</div>
        <div>@Html.ActionLink("Pass Due Assessments", "PastDueSurveys")</div>
        <div>@Html.ActionLink("Follow-ups", "Surveys")</div>
    </div>
}
@if (!ViewBag.ShowAdminContent && !ViewBag.ShowTeamMemberContent && !ViewBag.ShowManagerContent)
{
    <div>
        <div><h3>User Dashboard</h3></div>
        <div>@Html.ActionLink("Contact your Administrator to get access to the system", "About", "Home")</div>
    </div>
}