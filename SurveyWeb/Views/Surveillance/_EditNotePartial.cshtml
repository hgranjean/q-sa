@model SurveyWeb.Models.EditNoteViewModel

@*using (Ajax.BeginForm("EditNote", "Surveillance",
    new AjaxOptions { UpdateTargetId = "divid" + Model.QuestionId, InsertionMode = InsertionMode.Replace, HttpMethod = "POST", OnSuccess = "success" },
    new { enctype = "multipart/form-data" }))
{*@ 


    <div id="editNote" class="choiceGroup" style="display: table; width: 100%" data-ng-href="@(Model.QuestionId)">
        @Html.HiddenFor(m => m.NoteId)
        @Html.HiddenFor(m => m.SurveyId)
        @Html.HiddenFor(m => m.QuestionId)
        @Html.HiddenFor(m => m.QuestionGroupNumber)
        @Html.HiddenFor(m => m.ResponseId)
        <div style="display: table-row; width:100%">
            <div class="editor-label;" style="display: table-cell; width: 100%">
                @Html.LabelFor(m => m.NoteText, new { style = "max-width: 100%", @class = "control-label" })
            </div>
        </div>
        <div style="display: table-row; width:100%">
            <div id="questionText" class="editor-field" style="display: table-cell; width: 100%">
                
                @Html.TextAreaFor(m => m.NoteText, new { style = "max-width: 100%; height: 64px; border-width: 1px;", @class = "form-control mce-tinymce mce-container mce-panel", @hidefocus = "1", @tabindex = "-1", @role = "application" })
            </div>
        </div>

        <div style="display: table-row;">
            <div style="display: table-cell; width: 100%">
                <input id="saveButton" class="btn btn-default editNote" style="width: 100px;" value="Save" />
                <a href="#" class="questionCancel">Cancel</a>

            </div>
        </div>
    </div>

    @*}*@

