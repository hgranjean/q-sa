@model SurveyWeb.Models.PersonViewModel

@if (@Model.Person != null)
{
    if (System.Configuration.ConfigurationManager.AppSettings["ThemeLayout"] == "Arjuna")
    {
        <p>@Html.Label(Model.FirstName) @Html.Label(Model.LastName)</p>
        <small style="color: #eee;">@Html.Label(Model.JobTitle) // @Html.Label(Model.CompanyName)</small>
    }
    else
    {
        <h2 style="margin: 0; margin-top: initial">@Html.Label(Model.FirstName) @Html.Label(Model.LastName)</h2>
        <h4 style="margin: 0">@Html.Label(Model.JobTitle) // @Html.Label(Model.CompanyName)</h4>
    }
}

