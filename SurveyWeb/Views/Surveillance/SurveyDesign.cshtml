@using Atum.Domain.Surveillance
@using SurveyWeb.Models
@model SurveyWeb.Models.SurveyViewModel
@{
    ViewBag.Title = "Surveillance Template Design";
}

<hgroup class="title">
    <h1>@ViewBag.Title</h1>
    <!--<h2>Survey template.</h2>-->
</hgroup>

@using (Html.BeginForm("Save", "Surveillance", FormMethod.Post, new {enctype="multipart/form-data"}))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary()

    <fieldset>
        <legend>Edit Surveillance Template Design </legend>

        @Html.HiddenFor(m => m.Survey.ID)

        <div style="display: table">
            
            <div style="display: table-row">
                <div class="editor-label">
                    @Html.LabelFor(m => m.Survey.Title)
                </div>
                <div class="editor-field">
                    @Html.TextBoxFor(m => m.Survey.Title)
                </div>
            </div>
            <div style="display: table-row">
                <div class="editor-label">
                    @Html.LabelFor(model => model.Survey.SurveyType)
                </div>
                <div class="editor-field">
                    @Html.DropDownListFor(model => model.Survey.SurveyType,
                                          new SelectList(EnumUtils.GetEnumerableItems(typeof (SurveyType)),
                                                         "Value", "Text"))
                </div>
            </div>
            <div style="display: table-row">
                <div class="editor-label">
                    @Html.ActionLink("Create New Group", "CreateQuestionGroup", new {surveyId = Model.Survey.ID.ToString()})
                </div>
            </div>
        
            <h3>Question groups</h3>
            <div>
                @Html.EditorFor(m => m.QuestionGroupsViewModel)               
            
            </div>
            <div>&nbsp;</div>

        </div>
        <input type="submit" value="Save" />
        @Html.ActionLink("Cancel", "Surveys", "Surveillance")
    </fieldset>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
