@using Atum.Domain.Surveillance
@model SurveyWeb.Models.QuestionGroupViewModel

@{
    ViewBag.Title = "EditQuestionGroup";
}

<h2>EditQuestionGroup</h2>

<script src="~/Scripts/jquery-1.8.2.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

@using (Html.BeginForm("EditQuestionGroup", "Surveillance", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    <fieldset>
        <legend>QueryCategory</legend>

        @Html.HiddenFor(m => m.Number)
        @Html.HiddenFor(m => m.SurveyId)

        <!-- foreach (var group in Model.Survey.QuestionGroups.Where(qg => qg.Key == int.Parse(ViewBag.QuestionGroupId))) -->
            <div style="display: table">
                <div style="display: table-row">
                    <div id="groupTitle" style="display: table-cell; font-weight: bold; width: 20%"></div>
                </div>
                
                @foreach (var question in Model.Questions)
                {
                    <div id="choiceGroup" style="display: table-row">
                        <div class="editor-label">
                            @Html.Label((Model.Questions.IndexOf(question) + 1).ToString())
                        </div>
                            <div id="questionText" class="editor-field">
                                @Html.TextBoxFor(m => m.Questions[Model.Questions.IndexOf(question)].Text)
                            </div>
                        </div>
                }
            </div>

        <p>
            <input type="submit" value="Save" />
        </p>
    </fieldset>
}

<div>
    @Html.ActionLink("Back to List", "Surveys")
</div>
