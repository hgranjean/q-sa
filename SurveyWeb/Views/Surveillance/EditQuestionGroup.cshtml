@using Atum.Domain.Surveillance
@using MvcApplication1.Controllers
@using SurveyWeb.Models
@model SurveyWeb.Models.QuestionGroupViewModel

@{
    ViewBag.Title = "EditQuestionGroup";
}

<h2>Edit Question Group</h2>

<script src="~/Scripts/jquery-1.8.2.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

@using (Html.BeginForm("EditQuestionGroup", "Surveillance", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    <fieldset>
        <legend>Questions</legend>

        @Html.HiddenFor(m => m.Number)
        @Html.HiddenFor(m => m.SurveyId)
        
        <div style="display: table">
                <div style="display: table-row">
                <div id="groupLabel" style="display: table-cell; font-weight: bold; width: 50%">@Html.LabelFor(m => m.QuestionGroup.Title)</div>
                <div id="groupTitle" style="display: table-cell; font-weight: bold; width: 50%">@Html.TextBoxFor(m => m.QuestionGroup.Title)</div>
                </div>
        </div>
       
        @Html.ActionLink("Add question", "AddQuestion", new {surveyId = Model.SurveyId, questionGroupId = Model.Number})

        <div style="display: table;width:100%">
                @for (int i=0;Model.QuestionGroup.Questions!=null&&i<Model.QuestionGroup.Questions.Count;i++)
                {
                    @Html.HiddenFor(m => m.QuestionGroup.Questions[i].Number)

                <div id="choiceGroup" style="display: table-row;">
                    <div class="editor-label;" style="display: table-cell;width: 20%">
                            @Html.Label(Model.QuestionGroup.Questions[i].Number.ToString())
                        </div>
                    <div id="questionText" class="editor-field" style="display: table-cell;width: 80%">
                            @Html.TextBoxFor(m => m.QuestionGroup.Questions[i].Text)

                        @Html.DropDownListFor(m => m.QuestionGroup.Questions[i].QuestionType,
                            Model.QuestionGroup.Questions[i].QuestionType.ToSelectList(Model.QuestionGroup.Questions[i].QuestionType.ToString()))

                        @Html.DropDownListFor(m => m.QuestionGroup.Questions[i].TOCReference, 
                            new SelectList(new SurveillanceController().GetTOCs(), "Value.Title", "Key", Model.QuestionGroup.Questions[i].TOCReference))
                        </div>
                    </div>
                }
            </div>
        <p>
            <input type="submit" value="Save" />
        </p>
    </fieldset>
}

<div>
    @Html.ActionLink("Back to survey", "SurveyDesign", new{id=Model.SurveyId})
</div>
