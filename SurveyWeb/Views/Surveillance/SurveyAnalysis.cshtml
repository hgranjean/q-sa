@model SurveyWeb.Models.SurveyAnalysisViewModel

@{
    ViewBag.Title = "Survey Analysis";
}

<h2>Survey Analysis</h2>

<fieldset>
    <div class="editor-label">Questions answered</div>
    @if (Model.Followups != null)
    {
        <div class="editor-field">@Html.ValueFor(m => m.Result)</div>
        <div class="editor-label">Followups (@Html.ValueFor(m => m.Followups.ToList().Count))</div>
    
        foreach (var followup in Model.Followups)
        {
            <div class="editor-field">@Html.ValueFor(m => followup.TextResult)</div>
        }
    }
</fieldset>

