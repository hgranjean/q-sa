@using Microsoft.AspNet.Identity
@model SurveyWeb.Models.SurveysViewModel


@{
    ViewBag.Title = "Surveys";
}

<h2>Surveys</h2>

@if (Roles.IsUserInRole(User.Identity.GetUserId(), "Administrator") || Roles.IsUserInRole(User.Identity.GetUserId(), "Surveyor"))

{
    @Html.ActionLink("Create new survey", "SurveyDesign", "Surveillance")

    <div>
        @foreach (var item in Model.Surveys)
        {
            <div>
            
                @Html.ActionLink(item.Title ?? "Survey" + item.ID, "SurveyDesign", new {id = item.ID})
                &nbsp;
                @Html.ActionLink("Delete", "DeleteSurvey", new {id = item.ID})
            </div>
        }
    </div>

}

