@model SurveyWeb.Models.CompletedSurveyViewModel

@{
    ViewBag.Title = "Completed surveys";
}

<h2 style="background-color: lightgray;">My observations</h2>
    
    <div style="display: table; table-layout: fixed; width: 900px">
        <div style="display: table-row">
            <div style="display: table-cell">Date</div>
            <div style="display: table-cell">Department</div>
            <div style="display: table-cell">Observation</div>            
            <div style="display: table-cell">Assigned To</div>
            <div style="display: table-cell">Photo</div>
            <div style="display: table-cell">&nbsp;</div>
        </div>
        @foreach (var completedSurvey in Model.CompletedSurveys)
        {
            <div style="display: table-row">
                <div style="display: table-cell">
                    @Html.ValueFor(m => completedSurvey.SurveyDate)
                </div>                
                <div style="display: table-cell">
                    @Html.ValueFor(m => completedSurvey.Facility.Name)
                </div>
                <div style="display: table-cell">
                    @Html.ActionLink(completedSurvey.SurveyTitle, "ViewCompletedSurvey", new { responseId = completedSurvey.ResponseId })
                </div>
                <div style="display: table-cell">
                    &nbsp;
                </div>
                <div style="display: table-cell">
                    &nbsp;
                </div>
                <div style="display: table-cell; padding-bottom: 5px">
                    @Html.ActionLink("Export", "Export", null, new { @class = "btn btn-default" })
                    @Html.ActionLink("Archive", "Archive", null, new { @class = "btn btn-default" })
                </div>
            </div>
        }
    </div>



