@model SurveyWeb.Models.CompletedSurveyViewModel

@{
    ViewBag.Title = "Completed surveys";
}

<h2>Completed surveys</h2>

<fieldset>
    
@foreach (var completedSurvey in Model.CompletedSurveys)
{
    <div>@Html.ValueFor(m => completedSurvey.SurveyDate) - @Html.ValueFor(m => completedSurvey.SurveyTitle) @Html.ActionLink("View", "ViewCompletedSurvey", new { responseId = completedSurvey.ResponseId })</div>
}   
</fieldset>

