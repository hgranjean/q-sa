@model SurveyWeb.Models.CompletedObservationsViewModel

@{
    ViewBag.Title = "Completed observations";
}

<script type="text/javascript">
    $(document).ready(function () {
        $(".actionmenu").dropit();

        $.extend({
            confirm: function (title, message, yesText, yesCallback) {
                $("<div></div>").dialog({
                    buttons: [{
                        text: yesText,
                        click: function () {
                            yesCallback();
                            $(this).remove();
                        }
                    },
                    {
                        text: "Cancel",
                        click: function () {
                            $(this).remove();
                        }
                    }
                    ],
                    close: function (event, ui) { $(this).remove(); },
                    resizable: false,
                    title: title,
                    modal: true
                }).text(message).parent().addClass("alert");
            }
        });

        function questionDeleteClickHandler() {

            var parentId = $(this).parents('li').map(function () {
                return $(this).find('a').first().attr("data-ng-href");
            }).get().join(", ");

            $.confirm(
                "Delete response", //title
                "Delete the response " + parentId + "?", //message
                "Delete", //button text
                function deleteOk() { //"yes" callback

                    $.ajax({
                        type: 'POST',
                        url: '@Url.Content("~/Surveillance/Delete")',
                        data: {
                            responseId: parentId
                        },
                        success: function (data) {
                            location.reload();
                        },
                        error: function (xhr, status, error) {
                            console.log(xhr.responseText);
                        }
                    });
                }
            );
        }

        $('.responseDelete').click(questionDeleteClickHandler);
    });


</script>

<h2 class="section-header">My observations</h2>

<div class="panel">
    <div class="panel-body">
            <form method="GET" action="@Url.Action("AddObservation")" class="form-inline" role="form">
                <div class="form-group" style="width: 100%">
                    @Html.Partial("_AddObservation")
                    <button type="submit" class="btn btn-success" data-original-title="" title="">Add</button>
                </div>
            </form>
    </div>
</div>

<div style="display: table; table-layout: fixed; width: 100%">
    <div style="display: table-row">
        <div style="display: table-cell; width: 5%">##</div>
        <div style="display: table-cell; width: 50%">Observation</div>
        <div style="display: table-cell; width: 10%">Status</div>
        <div style="display: table-cell; width: 10%">Assigned To</div>
        <div style="display: table-cell; width: 10%">Photo</div>
        <div style="display: table-cell; width: 15%">&nbsp;</div>
    </div>


    @foreach (var completedObservation in Model.Observations)
    {
        <div style="display: table-row">
            <div style="display: table-cell">
                @Html.ValueFor(m => completedObservation.Observation.Question.Number)
            </div>
            <div style="display: table-cell">
                @Html.ValueFor(m => completedObservation.Observation.Question.Text)
                @* Html.ActionLink(completedSurvey.SurveyTitle, "ViewCompletedSurvey", new { id = completedSurvey.ResponseId }) *@
            </div>
            <div style="display: table-cell">
                @Html.ValueFor(m => completedObservation.Observation.Answer.Text)
            </div>
            <div style="display: table-cell">
                @Html.ValueFor(m => completedObservation.Observation.Person.FullName)
            </div>
            <div style="display: table-cell">
                &nbsp;
            </div>
            <div style="display: table-cell; padding-bottom: 5px">
                <div class="btn-group">
                    <button type="button" class="btn btn-default" data-original-title="" title=""><i class="fa"></i> Action</button>
                    <button type="button" class="btn btn-default active dropdown-toggle" data-toggle="dropdown" data-original-title="" title="">
                        <span class="caret"></span>
                        <span class="sr-only">Toggle Dropdown</span>
                    </button>
                    <ul class="dropdown-menu" role="menu">
                        <li>@Html.ActionLink("Take Photo", "TakePhoto", new { surveyId = 0 }, new { style = "width: 100px;" })</li>
                        <li>@Html.ActionLink("Assign To", "AssignTo", new { id = 0 }, new { style = "width: 100px;" })</li>
                        <li class="divider"></li>
                        <li><a class="responseDelete" style="width: 100px;" data-ng-href="0" href="#">Delete</a></li>
                    </ul>
                </div>
            </div>
        </div>
    }
</div>


