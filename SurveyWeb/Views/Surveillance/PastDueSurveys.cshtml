@using Microsoft.AspNet.Identity
@using SurveyWeb.Controllers
@using SurveyWeb.Models
@model SurveysViewModel
@{
    ViewBag.Title = "My Audits";
}

<h2>Past Due Surveys</h2>

@if (new AccountController().UserManager.IsInRole(User.Identity.GetUserId(), "Surveyor"))
{

    <div>
        @foreach (var item in Model.SurveysByDate.Keys)
        {
            <h3>@Html.Label(DateTimeUtils.GetGroupName(item))</h3>
            <div>
                @foreach (var survey in Model.SurveysByDate[item])
                {
                    <div>@Html.ActionLink(survey.Title ?? "Survey" + survey.ID, "SurveyDelivery", new {surveyId = survey.ID})</div>
                }
            </div>
        }
        
    </div>
}