@model SurveyWeb.Models.TracerViewModel
@{
    ViewBag.Title = Model.SurveyTitle;
}

<hgroup class="title">
    <h2>@*ViewBag.Title*@</h2>
</hgroup>

<link rel="stylesheet" href="//code.jquery.com/ui/1.10.4/themes/smoothness/jquery-ui.css">
@Scripts.Render("~/Scripts/jquery-ui-timepicker.js")

<script>
    $(function () {
        $("#startdatepicker").datetimepicker({
            timeFormat: 'HH:mm z',
            timezoneList: [
                { value: -300, label: 'Eastern' },
                { value: -360, label: 'Central' },
                { value: -420, label: 'Mountain' },
                { value: -480, label: 'Pacific' }
            ]
        });
        $("#enddatepicker").datetimepicker({
            timeFormat: 'HH:mm z',
            timezoneList: [
                { value: -300, label: 'Eastern' },
                { value: -360, label: 'Central' },
                { value: -420, label: 'Mountain' },
                { value: -480, label: 'Pacific' }
            ]
        });
    });
    
</script>

<script type="text/javascript">
    $.editNotePath = '@Url.Content("~/Surveillance/EditNote")';
</script>
<script type="text/javascript" src="~/Scripts/AQS/surveydelivery.js"></script>

@using (Html.BeginForm("SaveSurvey", "Surveillance", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary()
    @Html.HiddenFor(m => m.SurveyId)
    @Html.HiddenFor(m => m.ResponseId)
    
    <fieldset>
            <legend>Surveillance</legend>
            <div id="tracerHeader" style="display:table; width: 100%">
                @Html.Partial("_TracerHeaderPartial", Model, new ViewDataDictionary( new {GroupNumber =  1 }))
            </div>

            <table class="gn-table">

                @foreach (var group in Model.QuestionGroups)
            {
                
                <tr style="display:table-row" class="table-row-withborder" data-ng-ref="@(group.Number)">
                        <td id="groupTitle" style="display: table-cell; font-weight: bold; width: 35%; background-color: #CFDBC5; ">@Html.DisplayFor(m => group.QuestionGroup.Title)</td>
                        <td style="display: table-cell; font-weight: bold; width: 10%; text-align: center; color: red; background-color: #CFDBC5;">&nbsp;</td>
                        <td style="display: table-cell; font-weight: bold; width: 10%; text-align: center; background-color: #CFDBC5;">&nbsp;</td>
                        <td style="display: table-cell; font-weight: bold; width: 10%; text-align: center; color: blue;  background-color: #CFDBC5;">&nbsp;</td>
                        <td style="display: table-cell;font-weight:bold;width:15%; text-align: center;background-color: #CFDBC5;">Standard</td>
                        <td style="display: table-cell;font-weight:bold; width: 20%; background-color: #CFDBC5;">Notes / Photo / Document</td>
                    </tr>

                var questions = group.QuestionGroup.Questions;
                for (int qIndex = 0, i = 0; i < questions.ToArray().Length; i++)
                {
                    var question = questions[i];

                    <tr id="choiceGroup" style="display: table-row;" >
                        <td id="questionText" style="display:table-cell; width: 35%; vertical-align: middle" class="gn-table-row-withborders">@question.Text</td>

                        @{  var choiceClasses = new string[] {"red", "black", "blue"};

                            foreach (var choice in question.ResponseChoices)
                            {
                                var key = choice.Id;
                                var j = qIndex++;
                                var choiceIndex = question.ResponseChoices.IndexOf(choice);

                                <td style="display: table-cell; width: 10%;text-align: center;vertical-align:middle; height:20px;" class="gn-table-row-withborders">
                                    <div id="ck-button">
                                        <label class="@choiceClasses[choiceIndex]" data-ng-href="@(question.Number)" data-ng-groupid="@(group.Number)">

                                            @Html.RadioButtonFor(m => m.Responses[question.Number - 1], key,
                                                new { id = "Response" + key, name = "Question" + question.Number, @class = (@choiceClasses[choiceIndex] == "red" ? "requiresNote" : string.Empty) })
                                            <span>@choice.Text</span>

                                        </label>
                                    </div>
                                </td>
                            }
                        }

                        @if (question.TOCReference != null) // TODO: Replace with BaseReference.Title
                        {
                            <td id="questionBasis" style="display: table-cell; width:15%" class="gn-table-row-withborders">
                                @Html.ActionLink(question.TOCReference, "ViewReference", new {standardId=question.TOCReference})
                            </td>
                        }
                        else
                        {
                            <td style="display: table-cell; width: 15%" class="gn-table-row-withborders">&nbsp;</td>
                        }

                        <td style="display: table-cell; width: 20%; white-space: nowrap; vertical-align: middle" class="gn-table-row-withborders">
                            @Html.ActionLink("Notes", "EditNotes", "Surveillance", new { surveyId = @Model.SurveyId, questionId = question.Number }, new { @class = "gn-notes-icon", style = "display:inline" })
                            @Html.ActionLink("Load", "LoadAttachment", "Surveillance", new {surveyId = @Model.SurveyId, questionId = question.Number}, new { @class = "gn-upload-icon", style = "display:inline" })
                            @* Html.TextBoxFor(m => m.Notes, new {style = "width: 60%; float: left;"}) *@
                            @Html.ActionLink("Take Photo", "TakePhoto", "Surveillance", new {surveyId = @Model.SurveyId, questionId = question.Number}, new { @class = "gn-camera-icon", style = "display:inline" })
                            <span style="white-space: nowrap">
                                <!--<span id="file" class="gn-camera-icon" style="display: inline"></span>-->
                                <!--<input type="file" name="file" accept="image/*;capture=camera" style="opacity: 0; z-index: 1; display: inline; width:10px"
                                           onchange="alert("changed"); "document.getElementById('file').innerHTML = this.value; " /> -->
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="6" style="width: 100%">
                            <div id="divid@(question.Number)" data-ng-ref="@(group.Number)"></div>
                        </td>
                    </tr>
                }

                <tr style="display:table-row;">
                    <td colspan="6" style="width: 100%">
                        <div style="display: table-cell;" class="form-inline gn-table-row-withborders">
                            <div class="form-group">
                                <label class="sr-only" for="observationText">Text:</label>
                                @Html.Partial("_AddObservation")
                            </div>
                            <div class="checkbox">
                                <input type="submit" value="Add" id="addObservation" class="btn btn-default" />
                            </div>
                        </div>
                    </td>
                    <!--<div style="display: table-cell; vertical-align: middle;" class="gn-table-row-withborders"></div>
                    <div style="display: table-cell;" class="gn-table-row-withborders">&nbsp;</div>
                    <div style="display: table-cell;" class="gn-table-row-withborders">&nbsp;</div>
                    <div style="display: table-cell;" class="gn-table-row-withborders">&nbsp;</div>
                    <div style="display: table-cell;" class="gn-table-row-withborders">&nbsp;</div>
                    <div style="display: table-cell;" class="gn-table-row-withborders">&nbsp;</div>-->
                </tr>
            }
</table>
<div>&nbsp;</div>
            @if (ViewBag.IsReadOnly ?? false)
        {
            @Html.ActionLink("Close", "Dashboard", null, new { @class = "btn btn-default" })
        }
        else
        {

            <input type="submit" value="Done" class="btn btn-default" />
            @Html.ActionLink("Reset", "SurveyDelivery", new {id = 0})
        }
</fieldset>
}

            @section Scripts {
            @Scripts.Render("~/bundles/jqueryval")
            }
