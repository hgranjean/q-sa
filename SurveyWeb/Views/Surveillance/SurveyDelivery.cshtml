@model SurveyWeb.Models.TracerViewModel
@{
    ViewBag.Title = Model.SurveyTitle;
}

<hgroup class="title">
    <h2>@*ViewBag.Title*@</h2>
</hgroup>

<link rel="stylesheet" href="//code.jquery.com/ui/1.10.4/themes/smoothness/jquery-ui.css">
@Scripts.Render("~/Scripts/jquery-ui-timepicker.js")

<script>
  $(function() {      
      $("#startdatepicker").datetimepicker({
          timeFormat: 'HH:mm z',
          timezoneList: [
			{ value: -300, label: 'Eastern' },
			{ value: -360, label: 'Central' },
			{ value: -420, label: 'Mountain' },
			{ value: -480, label: 'Pacific' }
          ]
      });
      $("#enddatepicker").datetimepicker({
          timeFormat: 'HH:mm z',
          timezoneList: [
			{ value: -300, label: 'Eastern' },
			{ value: -360, label: 'Central' },
			{ value: -420, label: 'Mountain' },
			{ value: -480, label: 'Pacific' }
          ]
      });
  });
</script>

@using (Html.BeginForm("SaveSurvey", "Surveillance", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary()
    @Html.HiddenFor(m => m.SurveyId)
    
    <fieldset>
        <legend>Surveillance</legend>
        <div id="tracerHeader" style="display:table">
            <div style="display: table-row;">
                <div style="display: table-cell; width: 50%;" class="table-cell">
                    <div id="editorLabel" class="editor-label">@Html.LabelFor(m => m.FacilityId)</div>
                    <div id="editorField" class="editor-field">
                        @Html.DropDownListFor(m => m.FacilityId, new SelectList(Model.Facilities, "Id", "Name"), "Please select...", new { @class = "form-control" })
                    </div>
                </div>
                <div style="display:table-cell;width:5%">&nbsp;&nbsp;</div>
                <div style="display:table-cell;width:45%">&nbsp;&nbsp;</div>
            </div>
            
            <div style="display:table-row">
                <div style="display:table-cell;width:50%" class="table-cell">
                    <div id="editorLabel" class="editor-label">@Html.LabelFor(m => m.FloorNumber)</div>
                    <div id="editorField" class="editor-field">
                        @Html.TextBoxFor(m => m.FloorNumber, new { @class = "form-control" })
                    </div>
                </div>
                <div style="display:table-cell;width:5%">&nbsp;&nbsp;</div>
                <div style="display:table-cell;width:45%" class="table-cell">
                    <div id="editorLabel" class="editor-label">@Html.LabelFor(m => m.AreaId)</div>
                    <div id="editorField" class="editor-field">
                        @Html.DropDownListFor(m => m.AreaId, new SelectList(Model.Areas, "Id", "Name"), "Please select...", new { @class = "form-control" })
                    </div>
                </div>
            </div>
            
            <div style="display:table-row">
                <div style="display:table-cell;width:50%" class="table-cell">
                    <div id="editorLabel" class="editor-label">@Html.LabelFor(m => m.BuildingId)</div>
                    <div id="editorField" class="editor-field">
                        @Html.DropDownListFor(m => m.BuildingId, new SelectList(Model.Buildings, "Id", "Name"), "Please select...", new { @class = "form-control" })
                    </div>
                </div>
                <div style="display:table-cell;width:5%">&nbsp;&nbsp;</div>
                <div style="display:table-cell;width:45%">&nbsp;&nbsp;</div>
            </div>
            
            <div style="display:table-row">
                <div style="display:table-cell;width:50%" class="table-cell">
                    <div id="editorLabel" class="editor-label">@Html.LabelFor(m => m.SurveyorId)</div>
                    <div id="editorField" class="editor-field">
                        @Html.DropDownListFor(m => m.SurveyorId, new SelectList(Model.Surveyors, "Id", "FullName"), "Please select...", new { @class = "form-control" })
                    </div>
                </div>
                <div style="display:table-cell;width:5%">&nbsp;&nbsp;</div>
                <div style="display:table-cell;width:45%" class="table-cell">
                    <div id="editorLabel" class="editor-label">@Html.LabelFor(m => m.DepartmentId)</div>
                    <div id="editorField" class="editor-field">
                        @Html.DropDownListFor(m => m.DepartmentId, new SelectList(Model.Departments, "Id", "Name"), "Please select...", new { @class = "form-control" })
                    </div>
                </div>
            </div>
            <div style="display:table-row">
                <div style="display:table-cell;width:50%" class="table-cell">
                    <div id="editorLabel" class="editor-label">@Html.LabelFor(m => m.SurveyDate)</div>
                    <div id="editorField" class="editor-field">
                        @Html.TextBoxFor(m => m.SurveyDate, new { @id = "startdatepicker", @class = "form-control" })
                    </div>
                </div>
                <div style="display:table-cell;width:5%">&nbsp;&nbsp;</div>
                <div style="display:table-cell;width:45%" class="table-cell">
                    <div id="editorLabel" class="editor-label">@Html.LabelFor(m => m.SurveyTypeId)</div>
                    <div id="editorField" class="editor-field">
                        @Html.DropDownListFor(m => m.FacilityId, new SelectList(Model.Areas, "Id", "Name"), "Please select...", new { @class = "form-control" })
                    </div>
                </div>
            </div>
        </div>
        
        <div>&nbsp;</div>
        
        <div style="display: table;" class="gn-table">
            
            @foreach (var group in Model.QuestionGroups)
            {   
                <div style="display:table-row" class="table-row-withborder">
                    <div id="groupTitle" style="display: table-cell; font-weight: bold; width: 35%; background-color: #CFDBC5; ">@Html.DisplayFor(m => group.QuestionGroup.Title)</div>
                    <div style="display: table-cell; font-weight: bold; width: 10%; text-align: center; color:green; background-color: #CFDBC5;">&nbsp;</div>
                    <div style="display: table-cell; font-weight: bold; width: 10%; text-align: center; color: red; background-color: #CFDBC5;">&nbsp;</div>
                    <div style="display: table-cell; font-weight: bold; width: 10%; text-align: center; background-color: #CFDBC5;">&nbsp;</div>
                    <div style="display: table-cell; font-weight: bold; width: 10%; text-align: center; color: blue;  background-color: #CFDBC5;">&nbsp;</div>
                    <div style="display: table-cell;font-weight:bold;width:15%; text-align: center;background-color: #CFDBC5;">Standard</div>
                    <div style="display: table-cell;font-weight:bold;; background-color: #CFDBC5;">Notes / Photo / Document</div>
                </div>
                
                var questions = group.QuestionGroup.Questions;
                for (int qIndex = 0, i = 0; i < questions.ToArray().Length; i++)
                {
                    var question = questions[i];
                    
                    <div id="choiceGroup" style="display: table-row;" >                        
                            <div id="questionText" style="display:table-cell; width: 35%; vertical-align: middle" class="gn-table-row-withborders">@question.Text</div>
                            
                                @{  var choiceClasses = new string[] {"green", "red", "black", "blue"};                                    
                                    
                                    foreach (var choice in question.ResponseChoices)
                                    {
                                        var key = choice.ID;
                                        var j = qIndex++;
                                        var choiceIndex = question.ResponseChoices.IndexOf(choice);

                                        <div style="display: table-cell; width: 10%;text-align: center;vertical-align:middle; height:20px;" class="gn-table-row-withborders">                                            
                                            <div id="ck-button">
                                                <label class="@choiceClasses[choiceIndex]">

                                                    @Html.RadioButtonFor(m => m.Responses[question.Number - 1], key,
                                                         new { id = "Response" + key, name = "Question" + question.Number })
                                                    <span>@choice.Text</span>

                                                </label>
                                            </div>
                                        </div>
                                    }
                                }                            

                            @if (question.TOCReference != null) // TODO: Replace with BaseReference.Title
                            {
                                <div id="questionBasis" style="display: table-cell; width:15%" class="gn-table-row-withborders">
                                    @Html.ActionLink(question.TOCReference, "ViewReference", new {standardId=question.TOCReference})                                    
                                </div>
                            }
                            else
                            {
                                <div style="display: table-cell; width: 15%" class="gn-table-row-withborders">&nbsp;</div>
                            }

                            <div style="display: table-cell; width: 10%; white-space: nowrap; vertical-align: middle" class="gn-table-row-withborders">
                                @Html.ActionLink("Notes", "EditNotes", "Surveillance", null, new {@class = "gn-notes-icon", style = "display:inline"})
                                @Html.ActionLink("Load", "Load", "Surveillance", null, new { @class = "gn-upload-icon", style = "display:inline" })
                                @* Html.TextBoxFor(m => m.Notes, new {style = "width: 60%; float: left;"}) *@
                                @Html.ActionLink("Take Photo", "TakePhoto", "Surveillance", new {surveyId = @Model.SurveyId, questionId = question.Number}, new { @class = "gn-camera-icon", style = "display:inline" })
                                <span style="white-space: nowrap">
                                    <!--<span id="file" class="gn-camera-icon" style="display: inline"></span>-->                                    
                                    <!--<input type="file" name="file" accept="image/*;capture=camera" style="opacity: 0; z-index: 1; display: inline; width:10px"
                                        onchange="alert("changed"); "document.getElementById('file').innerHTML = this.value; " /> -->
                                </span>
                            </div>                        
                    </div>
               } 
                
                <div style="display:table-row;width:100%">
                    <div style="display: table-cell;" class="gn-table-row-withborders">@Html.TextBox("txtObservation" + group.Number, "", new { @class = "form-control" })</div>
                    <div style="display: table-cell; vertical-align: middle;" class="gn-table-row-withborders">                        
                        &nbsp;
                        <input type="submit" value="Add" id="addObservation" class="btn btn-default"/>
                    </div>
                    <div style="display: table-cell;" class="gn-table-row-withborders">&nbsp;</div>
                    <div style="display: table-cell;" class="gn-table-row-withborders">&nbsp;</div>
                    <div style="display: table-cell;" class="gn-table-row-withborders">&nbsp;</div>
                    <div style="display: table-cell;" class="gn-table-row-withborders">&nbsp;</div>
                    <div style="display: table-cell;" class="gn-table-row-withborders">&nbsp;</div>
                </div>
            }
        </div>
        <div>&nbsp;</div>
        @if (ViewBag.IsReadOnly ?? false)
        {
            @Html.ActionLink("Close", "Dashboard", null, new { @class = "btn btn-default" })
        }
        else
        {

            <input type="submit" value="Done" class="btn btn-default" />
            @Html.ActionLink("Reset", "SurveyDelivery", new {id = 0})
        }
</fieldset>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
