

@model SurveyWeb.Models.TracerViewModel
@{
    ViewBag.Title = "Life Safety ";
}

<hgroup class="title">
    <h1>@ViewBag.Title</h1>
</hgroup>

<link rel="stylesheet" href="//code.jquery.com/ui/1.10.4/themes/smoothness/jquery-ui.css">
@Scripts.Render("~/Scripts/jquery-ui-1.8.24.js")

<script>
  $(function() {
    $( "#datepicker" ).datepicker();
  });
</script>

@using (Html.BeginForm("SaveSurvey", "Surveillance", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary()

    <fieldset>
        <legend>Surveillance</legend>
        <div id="tracerHeader" style="display:table">
            <div style="display:table-row">
                <div style="display:table-cell;width:50%">
                    <div id="editorLabel" class="editor-label">@Html.LabelFor(m => m.FacilityId)</div>
                    <div id="editorField" class="editor-field">
                        @Html.DropDownList("FacilityId", new SelectList(Model.Facilities, "Id", "Name"), "Please select...", null)
                    </div>
                </div>
                <div style="display:table-cell;width:5%">&nbsp;&nbsp;</div>
                <div style="display:table-cell;width:45%">&nbsp;&nbsp;</div>
            </div>
            
            <div style="display:table-row">
                <div style="display:table-cell;width:50%">
                    <div id="editorLabel" class="editor-label">@Html.LabelFor(m => m.FloorNumber)</div>
                    <div id="editorField" class="editor-field">
                        @Html.EditorFor(m => m.FloorNumber)
                    </div>
                </div>
                <div style="display:table-cell;width:5%">&nbsp;&nbsp;</div>
                <div style="display:table-cell;width:45%">
                    <div id="editorLabel" class="editor-label">@Html.LabelFor(m => m.AreaId)</div>
                    <div id="editorField" class="editor-field">
                        @Html.DropDownList("AreaId", new SelectList(Model.Areas, "Id", "Name"), "Please select...", null)
                    </div>
                </div>
            </div>
            
            <div style="display:table-row">
                <div style="display:table-cell;width:50%">
                    <div id="editorLabel" class="editor-label">@Html.LabelFor(m => m.BuildingId)</div>
                    <div id="editorField" class="editor-field">
                        @Html.DropDownList("FloorNumber", new SelectList(Model.Buildings, "Id", "Name"), "Please select...", null)
                    </div>
                </div>
                <div style="display:table-cell;width:5%">&nbsp;&nbsp;</div>
                <div style="display:table-cell;width:45%">&nbsp;&nbsp;</div>
            </div>
            
            <div style="display:table-row">
                <div style="display:table-cell;width:50%">
                    <div id="editorLabel" class="editor-label">@Html.LabelFor(m => m.SurveyorId)</div>
                    <div id="editorField" class="editor-field">
                        @Html.DropDownList("SurveyorId", new SelectList(Model.Surveyors, "Id", "Name"), "Please select...", null)
                    </div>
                </div>
                <div style="display:table-cell;width:5%">&nbsp;&nbsp;</div>
                <div style="display:table-cell;width:45%">
                    <div id="editorLabel" class="editor-label">@Html.LabelFor(m => m.DepartmentId)</div>
                    <div id="editorField" class="editor-field">
                        @Html.DropDownList("DepartmentId", new SelectList(Model.Departments, "Id", "Name"), "Please select...", null)
                    </div>
                </div>
            </div>
            <div style="display:table-row">
                <div style="display:table-cell;width:50%">
                    <div id="editorLabel" class="editor-label">@Html.LabelFor(m => m.SurveyDate)</div>
                    <div id="editorField" class="editor-field">
                        @Html.TextBoxFor(m => m.SurveyDate, new {@id = "datepicker"})
                    </div>
                </div>
                <div style="display:table-cell;width:5%">&nbsp;&nbsp;</div>
                <div style="display:table-cell;width:45%">
                    <div id="editorLabel" class="editor-label">@Html.LabelFor(m => m.SurveyTypeId)</div>
                    <div id="editorField" class="editor-field">
                        @Html.DropDownList("FacilityId", new SelectList(Model.Areas, "Id", "Name"), "Please select...", null)
                    </div>
                </div>
            </div>
        </div>
        
        <div>&nbsp;</div>

        <div style="display: table; table-layout: fixed;">
            <div style="display:table-row">
                <div id="groupTitle" style="display:table-cell;font-weight:bold;width:40%">Questions</div>
                <div style="display:table-cell;width:10%">Compliant</div>
                <div style="display:table-cell;width:10%">Non-Compliant</div>
                <div style="display:table-cell;width:5%">N/A</div>
                <div style="display:table-cell;width:10%">Follow-up</div>
                <div style="display:table-cell;width:10%">Standards</div>
                <div style="display:table-cell;width:20%">Notes/Photo/Document</div>
            </div>

            @foreach (var group in Model.QuestionGroups)
            {   
                <div style="display:table-row">
                    <div id="groupTitle" style="display:table-cell;font-weight:bold;width:20%">@*group.Title*@</div>
                </div>
                
                var questions = group;
                for (int qIndex = 0, i = 0; i < questions.ToArray().Length; i++)
                {
                    var question = questions[i];

                    <div id="choiceGroup" style="display: table-row-group">
                        <div style="display:table-row;width:100%">
                            <!--<div id="questionLabel" style="font-weight:bold"></div>-->
                            <div id="questionText" style="display:table-cell;">@question.Question.Text</div>
                        </div>
                            
                        <div style="display:table-row;width:100%">
                            <div style="display:table-cell"></div>
                                @foreach (var choice in question.Choices)
                                {
                                    var key = choice.ID;
                                    var j = qIndex++;
                                    
                                    <div style="display:table-cell">@Html.RadioButtonFor(m => m.Responses[int.Parse(key.ToString())], key, new { id = "Response" + key, name = "Response" + i, @class = "sur-choice" })</div>
                                }

                            @if (question.Question.BasisReference != null)
                                {
                                    <div id="questionBasis" style="display: table-cell">@Html.ActionLink(question.Question.BasisReference.Title, "ViewReference")</div>
                                }
                                else
                                {
                                    <div style="display:table-cell">&nbsp;</div>
                                }

                                <div style="display:table-cell">
                                    @Html.TextBoxFor(m => m.Notes, new {style = "width: 60%; float: left;"})
                                    &nbsp;@Html.ActionLink("Camera", "Camera", "Surveillance", null, new {@class = "gn-camera-icon"})
                                    &nbsp;@Html.ActionLink("Load", "Load", "Surveillance", null, new {@class = "gn-upload-icon"})
                                </div>
                        </div>
                    </div>
                
                }
            }
            </div>
            <input type="submit" value="Done" />
            <input type="submit" value="Reset" />
</fieldset>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
