@using SurveyWeb.Models
@{
    ViewBag.Title = "Calendar";
}

@Styles.Render("~/Content/fullcalendar.css")
@Styles.RenderFormat(BundlesFormats.PRINT, "~/Content/fullcalendar.print.css")
@Scripts.Render("~/Scripts/fullcalendar/moment.min.js")
@Scripts.Render("~/Scripts/jquery-ui-1.8.24.js")
@Scripts.Render("~/Scripts/fullcalendar/fullcalendar.min.js")
@Scripts.Render("~/Scripts/fullcalendar/gcal.js")
<script>
    $(document).ready(function () {

        $('#calendar').fullCalendar({
            header: {
                left: 'prev,next today',
                center: 'title',
                right: 'month,agendaWeek,agendaDay'
            },
            defaultView: 'month',
            editable: true,
        
            // US Holidays
            // events: 'http://www.google.com/calendar/feeds/usa__en%40holiday.calendar.google.com/public/basic',
            events: { url: 'GetTasks?start=1&end=2' },

            eventClick: function (event) {
                // opens events in a popup window
                // window.open(event.url, 'gcalevent', 'width=700,height=600');
                window.location.href = "EditEvent/" + event.id;
                return false;
            },
            
            /*
            events: function (request, response) {
                $.ajax({
                    url: "/Surveillance/GetEvents/",
                    dataType: "json",
                    success: function (data) {
                        response(JSON.parse(data));
                    }
                });
            },*/
           
            /*events: function (request, response) {
                    $.ajax({
                        url: "/Surveillance/GetEvents/",
                        dataType: "json",
                        success: function (data) {
                            response(JSON.parse(data));
                        }
                    });
            },*/
        });
    });
</script>

<style>
    
    #calendar {
        width: 900px;
        margin: 40px auto;
    }

</style>

<h2>Calendar</h2>

@Html.ActionLink("Create task", "CreateTask", "Surveillance")

<div id="calendar"></div>