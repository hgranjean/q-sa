@using Microsoft.AspNet.Identity
@using SurveyWeb.Controllers
@using SurveyWeb.Models
@model SurveysViewModel
@{
    ViewBag.Title = "Calendar";
}

<h2 class="section-header">Calendar</h2>

@if (new AccountController().UserManager.IsInRole(User.Identity.GetUserId(), "Manager") ||
new AccountController().UserManager.IsInRole(User.Identity.GetUserId(), "Team Member"))
{

    <div>
        @foreach (var item in Model.SurveysByDate.Keys)
        {
            <h3>@Html.Label(DateTimeUtils.GetGroupName(item))</h3>
            <div>
                @foreach (var survey in Model.SurveysByDate[item])
                {
                    <div>@Html.ActionLink(survey.Title ?? "Survey" + survey.ID, "SurveyDelivery", new {survey.ID})</div>
                }
            </div>
        }
        
    </div>
}

<link rel="stylesheet" href="//code.jquery.com/ui/1.10.4/themes/smoothness/jquery-ui.css">
<style>
    #datepicker {
        font-size: 0.8em;
    }
</style>
@*Scripts.Render("~/Scripts/jquery-ui-1.8.24.js") *@
@Scripts.Render("~/Scripts/jquery-ui-timepicker.js")

<script>
    $(function () {
        $("#datepicker").datepicker({
            onSelect: function (date) {                
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("RedirectToCalendar")',
                    data: { date: date },
                    dataType: 'json',
                    success: function (data) {                        
                        window.location.href = data;
                    }                       
                });                
            }
            });
    });
</script>

<div>&nbsp;</div>

<div>
    <div id="datepicker"></div>
</div>
