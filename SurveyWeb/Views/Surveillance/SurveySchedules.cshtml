@using Microsoft.AspNet.Identity
@using SurveyWeb.App_Start
@using SurveyWeb.Controllers
@model SurveyWeb.Models.SurveysViewModel
@{
    ViewBag.Title = "My Audits";
}

<h2>My Audits</h2>

@if (new AccountController().UserManager.IsInRole(User.Identity.GetUserId(), "Surveyor"))
{

    <div>
        @foreach (var item in Model.Surveys)
        {
            <div>@Html.ActionLink(item.Title ?? "Survey" + item.ID, "SurveyDelivery", new {surveyId = item.ID})</div>
        }
    </div>
}
