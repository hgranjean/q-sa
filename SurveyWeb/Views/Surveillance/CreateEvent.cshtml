@model SurveyWeb.Models.EventViewModel
@{
    ViewBag.Title = "CreateEvent";
}

<hgroup class="title">
    <h1>@ViewBag.Title</h1>
</hgroup>


<link rel="stylesheet" href="//code.jquery.com/ui/1.10.4/themes/smoothness/jquery-ui.css">
@Scripts.Render("~/Scripts/jquery-ui-1.8.24.js")

<script>
  $(function() {
      $("#startdatepicker").datepicker();
      $("#enddatepicker").datepicker();
  });
</script>

@using (Html.BeginForm("CreateEvent", "Surveillance", FormMethod.Post, new {enctype="multipart/form-data"}))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary()

    <fieldset>
        <legend>Create Event</legend>

        <div style="display: table">
            
            <div style="display: table-row">
                <div class="editor-label">
                    @Html.LabelFor(m => m.Title)
                </div>
                <div class="editor-field">
                    @Html.TextBoxFor(m => m.Title)
                </div>
            </div>
            <div style="display: table-row">
                <div class="editor-label">
                    @Html.LabelFor(model => model.Start)
                </div>
                <div class="editor-field">
                    @Html.TextBoxFor(m => m.Start, new {@id = "startdatepicker"})
                </div>
            </div>
            <div style="display: table-row">
                <div class="editor-label">
                    @Html.LabelFor(model => model.End)
                </div>
                <div class="editor-field">
                    @Html.TextBoxFor(m => m.Start, new {@id = "enddatepicker"})
                </div>
            </div>
            <div style="display: table-row">
                <div class="editor-label">
                    @Html.LabelFor(model => model.Url)
                </div>
                <div class="editor-field">
                    @Html.TextBoxFor(m => m.Url)
                </div>
            </div>
        
            <div>&nbsp;</div>

        </div>
        <input type="submit" value="Save" />
        @Html.ActionLink("Cancel", "Surveys", "Surveillance")
    </fieldset>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

