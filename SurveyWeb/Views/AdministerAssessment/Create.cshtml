@using Atum.Domain.Surveillance
@using SurveyWeb.Models
@model SurveyWeb.Models.AdministeredAssessmentViewModel

@{
    ViewBag.Title = "AdministerAssessment";
}

<h2>Administer assessment</h2>

Survey

@using (Html.BeginForm("Save", "AdministerAssessment")) {
    @Html.AntiForgeryToken()
    @Html.ValidationSummary()

    <fieldset>
        <legend>Admin assessment Form</legend>
        <div class="editor-label">
            @Html.LabelFor(m => m.AdministeredAssessment.AdministeredSurvey.SurveyType)
        </div>
        <div class="editor-field">
            @Html.DropDownListFor(m => m.AdministeredAssessment.AdministeredSurvey.SurveyType, 
                                  new SelectList(EnumUtils.GetEnumerableItems(typeof(SurveyType)), 
                                                 "Value", "Text"))
        </div>
    </fieldset>
    
    <br/>
    <input type="submit" value="Save assessment" />
    
}


