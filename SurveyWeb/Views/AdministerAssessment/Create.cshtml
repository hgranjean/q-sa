@using Atum.Domain.Surveillance
@using SurveyWeb.Models
@model SurveyWeb.Models.SurveyViewModel

@{
    ViewBag.Title = "AdministerAssessment";
}

<h2>Administer assessment</h2>

Survey

@using (Html.BeginForm("Save", "AdministerAssessment"))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary()

    <fieldset>
        <legend>Admin assessment Form</legend>

        <div class="editor-label">
            @Html.LabelFor(model => model.Name)
        </div>
        <div class="editor-field">
            @Html.EditorFor(model => model.Name)
        </div>
        <div class="editor-label">
            @Html.LabelFor(model => model.Survey.SurveyType)
        </div>
        <div class="editor-field">
            @Html.DropDownListFor(model => model.Survey.SurveyType,
                                  new SelectList(EnumUtils.GetEnumerableItems(typeof (SurveyType)),
                                                 "Value", "Text"))
        </div>
        
        <div>Question groups
            @if (Model != null)
            {
                @Html.Partial("QuestionGroupIndex", Model)
            }
        </div>

    </fieldset>
    
    <br/>
    <input type="submit" value="Save assessment" />
    
}


