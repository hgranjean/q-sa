@using Microsoft.AspNet.Identity
@{
    ViewBag.Title = "Settings";
}

<h2>Settings</h2>


<div class="row">
    @if (ViewBag.ShowAdminContent)
    {
        <div class="col-md-4">
            <h2>Manage Facilities</h2>
            <p>
                Review existing facilities.
            </p>
            <p>@Html.ActionLink("List facilities", "Index", "Hospital", null, new {@class = "btn btn-default"})</p>
        </div>
    }

    @if (ViewBag.ShowAdminContent || ViewBag.ShowManagerContent)
    {
        <div class="col-md-4">
        <h2>Manage users</h2>
        <p>
            Manage user records, their assignments to facilities.
        </p>
        <p>@Html.ActionLink("List users", "UserHospitalIndex", "Hospital", null, new {@class = "btn btn-default"})</p>
            
        </div>
        
        <div class="col-md-4">
        <h2>Manage standards</h2>
        <p>
            Manage standards, chapters, elements and test observation classifications.
        </p>        
        <p>@Html.ActionLink("Manage standards", "Document", "Standard", new { id = 1 }, new { @class = "btn btn-default" })</p>
        <p>@Html.ActionLink("Observation Classification", "ObservationClassifier", "Learning", null, new { @class = "btn btn-default" })</p>
        <p>@Html.ActionLink("Standard Training", "NBTrainingDocument", "Learning", null, new { @class = "btn btn-default" })</p>
        
        
        </div>
    }
</div>

