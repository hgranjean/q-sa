

@{
    ViewBag.Title = "Getting started";
}
<hgroup class="title">
    <h1>@ViewBag.Title</h1>
    <h2>@ViewBag.Message</h2>
</hgroup>

<div class="jumbotron">
    <h1>AQS EOC</h1>
    <p class="lead">The AQS EOC product includes Standard Best Practice Templates (A/K/A Assessments) developed from practical use which track and rank items in reference to Joint Commission Compliance.  
        <br />All template questions are to be linked to The Joint Commission (TJC) standards.  This provides reporting of the Medical Center against each specified performance standard.
        <br />AQS will provide on-line (off-line) assessments which are customized with standardized questions and scoring criteria with a comment section under each question 
        for internal inspectors to fill out while conducting scheduled rounds and audits.  
    </p>
    <p>@Html.ActionLink(HttpUtility.HtmlDecode("Do more &raquo;"), "Dashboard", "Surveillance", null, new { @class = "btn btn-primary btn-large" })</p>
</div>

<div class="row">
    <div class="col-md-4">
        <h2>Getting started</h2>
        <p>
            Review existing surveys/templates.
        </p>
        <p>@Html.ActionLink(HttpUtility.HtmlDecode("Go &raquo;"), "Dashboard", "Surveillance", null, new { @class = "btn btn-default" })</p>
    </div>
    <div class="col-md-4">
        <h2>Create new Templates</h2>
        <p>All template questions are linked to The Joint Commission (TJC) standards. Also, templates have the flexibility to be changed for local conditions.</p>

        <p>@Html.ActionLink(HttpUtility.HtmlDecode("Go &raquo;"), "Surveys", "Surveillance", null, new { @class = "btn btn-default" })</p>
    </div>
    <div class="col-md-4">
        <h2>Conduct a Survey</h2>
        <p>Select from existing Templates.</p>
        <p>@Html.ActionLink(HttpUtility.HtmlDecode("Go &raquo;"), "SurveySchedules", "Surveillance", null, new { @class = "btn btn-default" })</p>
    </div>
</div>

