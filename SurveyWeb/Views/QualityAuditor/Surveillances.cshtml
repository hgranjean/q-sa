@model SurveyWeb.Models.QualityAuditor.SurveillancePerformance.SurveillancesViewModel
@{
    ViewBag.Title = "Assigned Surveillances";
}

<link href="~/Content/themes/GridStyle.css" rel="stylesheet" />


<h2>Assigned Surveillances</h2>


<div id="sectionOne">
    <h3 class="section-header">List of Assigned Rounds/Surveillances</h3>
    @{
        var gridModel = Model.Surveillances;
        var grid = new WebGrid(gridModel, rowsPerPage: 10);
        List<WebGridColumn> cols = new List<WebGridColumn>();

        cols.Add(grid.Column("Id", format: (item) => Html.ActionLink((string)item.Id.ToString(), "Surveillance", new { id = item.Id })));
        cols.Add(new WebGridColumn() { ColumnName = "Area", Header = "Area" });
        cols.Add(new WebGridColumn() { ColumnName = "Start", Header = "Start Date" });
        cols.Add(new WebGridColumn() { ColumnName = "End", Header = "Expected Completion Date" });
        cols.Add(new WebGridColumn() { ColumnName = "OwnerName", Header = "Owner" });
        //cols.Add(new WebGridColumn() { ColumnName = "Manager", Header = "Manager" });
        cols.Add(new WebGridColumn() { ColumnName = "CurrentState", Header = "Status" });
        cols.Add(new WebGridColumn() { ColumnName = "IssuesCount", Header = "Issues Found" });



    }
    <div id="gridContent">
        @grid.GetHtml(
                 tableStyle: "webgrid-table",
                 headerStyle: "webgrid-header",
                 footerStyle: "webgrid-footer",
                 alternatingRowStyle: "webgrid-alternating-rows",
                 rowStyle: "row-style",
                 fillEmptyRows: false, mode: WebGridPagerModes.All, columns: cols
            )
    </div>
 </div>
