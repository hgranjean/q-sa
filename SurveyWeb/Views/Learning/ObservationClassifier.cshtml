@using SurveyWeb.Models
@using System.Web.Mvc.Ajax;

@model SurveyWeb.Models.StandardElementViewModel

@{
    ViewBag.Title = "Observation Classifier";
}

<h2>Observation Classifier</h2>

 <form id="observationForm" method="get">
    <div style="display: table-row">
        <div class="editor-label">
            @Html.LabelFor(model => model.Observation)
        </div>
    </div>
    <div id="observation-text" style="display: table-row">
        @Html.TextAreaFor(model => model.Observation, new { id = "observationText", name = "observation", data_aqs_ajax = "true", data_aqs_target="#classDisplay", cols = 75, @rows = 5 })
    </div>
</form>

@Html.Partial("_ObservationClass",Model)

<script>
    $(‘#standardText’).tooltip({
        track: true
    });

</script>
<script src="~/Scripts/AQS/observationclassifier.js"></script>

