@using SurveyWeb.Models
@using System.Web.Mvc.Ajax;

@model SurveyWeb.Models.StandardElementViewModel

@{
    ViewBag.Title = "Observation Classifier";
}

<h2>Observation Classifier</h2>

@using (Ajax.BeginForm(
        new AjaxOptions
        {
            HttpMethod = "get",
            InsertionMode = InsertionMode.Replace,
            UpdateTargetId = "EPIdList"

        }))
{
    <div id="observation-text" style="display: table-row">
        @Html.TextAreaFor(model => model.Observation, new { id = "observationText", name = "observation", cols = 75, @rows = 5 })
        @*<textarea name="observation" id="observationText"></textarea>*@
        @*<input type="submit" name="classify" value="classify" />*@
    </div>
    <div id="labels" style="display: table-row">

        <div class="editor-label">
            @Html.LabelFor(model => model.StandardId)
        </div>
        <div class="editor-label">
            @Html.LabelFor(model => model.EPIds)
        </div>

    </div>
    <div>
        <div id="epIdList" style="display: table-row">
            <div>
                @Html.TextBoxFor(model => model.StandardId)

                @if (Model.EPIds != null)
                {

                    @Html.DropDownListFor(model => model.EPIds,
                                        new SelectList(Model.EPIds), "", new { id = "EPIdList" })
                }
            </div>
        </div>
    </div>
}
<script src="~/Scripts/AQS/aqs.js"></script>