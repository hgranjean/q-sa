@using SurveyWeb.Models

@model SurveyWeb.Models.TrainingDocumentViewModel


@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="//code.jquery.com/jquery-1.10.2.js"></script>
<script type="text/javascript" src="~/Scripts/jquery-1.6.4.min.js"></script>

@*@using (Html.BeginForm("NBTrainingDocument", "Learning", FormMethod.Post, new { enctype = "multipart/form-data" }))*@
@using (Ajax.BeginForm(
        new AjaxOptions
        {
            HttpMethod = "get",
            InsertionMode = InsertionMode.Replace,
            UpdateTargetId = "classText"

        }))
{
    @Html.AntiForgeryToken()
    <h4>Naive Bayes Training Document</h4>
    <hr />
    @Html.ValidationSummary()

    @*@Html.HiddenFor(m => m.Person.Id)*@

    <div class="form-group">
        @Html.LabelFor(m => m.Class, new { @class = "col-md-2 control-label" })
        <div class="col-md-10">
            @*@Html.TextBoxFor(m => m.Class, new { @class = "form-control" })*@
            @Html.DropDownListFor(model => model.ClassList,
                               new SelectList(Model.ClassList), "", new { id = "ClassList", @class = "form-control" })
    </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Text, new { @class = "col-md-2 control-label" })
        <div class="col-md-10">
            @*@Html.TextBoxFor(m => m.Text, new { @class = "form-control" })*@
            @Html.TextAreaFor(m => m.Text, new { id = "classText", name = "classText", cols = 175, @rows = 15, @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Save" class="btn btn-default" />
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
<script src="~/Scripts/AQS/aqs.js"></script>