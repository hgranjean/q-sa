@using SurveyWeb.Models
@model SurveyWeb.Models.TrainingDocumentViewModel

<div id="documentText" class="form-group">
    @Html.LabelFor(model => model.Text, new { @class = "col-md-2 control-label" })
    <div class="col-md-10">
        @Html.TextAreaFor(model => model.Text, new { id = "classText", name = "classText",  cols = 175, @rows = 15, @class = "form-control" })
    </div>
    <div>@Html.TextBoxFor(model => model., new { @class = "form-control" })
    </div>
</div>

