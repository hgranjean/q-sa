@if (Request.IsAuthenticated)
{   
    if (System.Configuration.ConfigurationManager.AppSettings["ThemeLayout"] == "Arjuna")
    {
        <li>
            <div class="navbar-login">
                <div class="row">
                    <div class="col-lg-3">
                        <p class="text-center">
                            <!--<img src="@Url.Content("~/Content/themes/arjuna/img/user.jpg")" class="img-responsive img-circle">-->                            
                        </p>
                    </div>
                    <div class="col-lg-9">
                        <p class="text-left"><strong>@User.Identity.Name</strong></p>
                        <!--<p class="text-left small">johndoe@aqspartners.com</p>-->
                        <div class="row">
                            <div class="col-md-6">
                                @Html.ActionLink("Edit Profile", "Manage", "Account", routeValues: null, htmlAttributes: new { title = "Manage" })
                            </div>
                            @*
                            <div class="col-md-6">
                                <small>@Html.ActionLink("Invite  People", "InvitePeople", "Account")</small>
                            </div>
                                *@
                        </div>
                    </div>
                </div>
            </div>
        </li>
        <li class="divider"></li>
        <li>
            <div class="navbar-login navbar-login-session">
                @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "navbar-right" }))
                {
                    @Html.AntiForgeryToken()
                    <a href="javascript:document.getElementById('logoutForm').submit()" class="btn btn-default btn-square btn-block">Sign off</a>
                }
                </div>
            </li>
    } else {
        <div>
            @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "navbar-right" }))
            {
                @Html.AntiForgeryToken()

                <ul class="nav navbar-nav navbar-right">
                    <li>
                        @Html.ActionLink("Hello " + User.Identity.Name + "!", "Manage", "Account", routeValues: null, htmlAttributes: new { title = "Manage" })
                    </li>
                    <li>
                        @Html.ActionLink("Invite  People", "InvitePeople", "Account")
                    </li>
                    <li><a href="javascript:document.getElementById('logoutForm').submit()">Sign off</a></li>
                </ul>

            }
        </div>
    }
}
else
{
    if (System.Configuration.ConfigurationManager.AppSettings["ThemeLayout"] == "Arjuna")
    {
        <ul class="nav navbar-nav navbar-right">
            <li>@Html.ActionLink("Sign up", "Register", "Account", routeValues: null, htmlAttributes: new { id = "registerLink" })</li>
            <li>@Html.ActionLink("Log in", "Login", "Account", routeValues: null, htmlAttributes: new { id = "loginLink" })</li>
        </ul>
    }
    else
    {
        <ul class="nav navbar-nav navbar-right">
            <li>@Html.ActionLink("Sign up", "Register", "Account", routeValues: null, htmlAttributes: new { id = "registerLink" })</li>
            <li>@Html.ActionLink("Log in", "Login", "Account", routeValues: null, htmlAttributes: new { id = "loginLink" })</li>
        </ul>
    }
}


